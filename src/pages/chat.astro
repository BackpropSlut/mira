---
import Base from '../layouts/Base.astro';
import MiniCloud from '../components/MiniCloud.astro';
import Sky from '../components/Sky.astro';

// Один экран, два входа: сайт (/chat) и Telegram Mini App (бот открывает эту же страницу).
// Разговор идёт только через API бота (bot/API.md), адрес в PUBLIC_MIRA_API. Пока его нет, страница честно говорит «скоро»
// и даёт подышать: данные о самочувствии через Vercel и Google не отправляем (152-ФЗ, ux-logic §3.6).
const soon = !import.meta.env.PUBLIC_MIRA_API;
---
<Base app title="Поговорить с Inlo" description="Напиши, что тревожит: Inlo выслушает, поможет разобрать мысль и подышит вместе с тобой. AI-поддержка, не заменяет психолога, 18+.">
  <script is:inline>
    // SDK Telegram грузим только внутри Telegram: обычный посетитель сайта ничего не отправляет на telegram.org
    if (/tgWebApp/.test(location.hash + location.search)) {
      document.documentElement.classList.add('tg');
      document.write('<script src="https://telegram.org/js/telegram-web-app.js?59"><\/script>');
    }
  </script>

  <div class:list={['chat', { soon }]}>
    <Sky bare />
    <header class="bar">
      <a class="back" href="/" aria-label="На главную">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
      <div class="who">
        <span class="ava"><MiniCloud size={30} /></span>
        <span class="name"><b>Inlo <i class="plus-badge" hidden>Plus</i></b><small class="status">AI, не психолог</small></span>
      </div>
      <a class="sos" href="/help">Помощь</a>
      <button class="more" type="button" aria-label="Ещё" aria-expanded="false" aria-controls="menu">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="5" cy="12" r="1.8"/><circle cx="12" cy="12" r="1.8"/><circle cx="19" cy="12" r="1.8"/></svg>
      </button>
      <div class="menu" id="menu" role="menu" hidden>
        <button type="button" role="menuitem" data-act="breathe">Подышать минуту</button>
        {!soon && <button type="button" role="menuitem" data-act="voice">Голос Inlo: <span class="v-label">женский</span></button>}
        {!soon && <button type="button" role="menuitem" data-act="plus">Inlo Plus</button>}
        {!soon && <button type="button" role="menuitem" data-act="reset">Забыть разговор</button>}
        <a role="menuitem" href="/privacy">Конфиденциальность</a>
      </div>
    </header>

    <section class="gate on-sky" aria-labelledby="gate-h">
      <div class="g-cloud" aria-hidden="true"><MiniCloud size={92} /></div>
      <h1 id="gate-h">Привет, я&nbsp;Inlo.</h1>
      <p class="g-lead">Выслушаю, помогу разобрать тревожную мысль и&nbsp;подышу вместе с&nbsp;тобой.</p>
      <ul class="facts">
        <li><span class="ic" aria-hidden="true">AI</span><span><b>Я AI, а&nbsp;не&nbsp;психолог.</b> Не&nbsp;ставлю диагнозов и&nbsp;не&nbsp;заменяю специалиста.</span></li>
        <li><span class="ic sos-ic" aria-hidden="true">+</span><span><b>Если очень плохо,</b> звони 112 или на&nbsp;линию МЧС. Номера всегда под кнопкой «Помощь» сверху.</span></li>
        {soon
          ? <li><span class="ic" aria-hidden="true">i</span><span><b>Разговор откроется к&nbsp;запуску.</b> Готовим для Inlo собственный сервер, чтобы твои сообщения не&nbsp;шли через чужие сервисы. Подышать вместе можно уже сейчас.</span></li>
          : <li><span class="ic" aria-hidden="true">i</span><span><b>Без регистрации.</b> Не&nbsp;спрашиваю имя и&nbsp;телефон.</span></li>}
      </ul>
      {soon ? (
        <>
          <button class="start" type="button" data-act="breathe">Подышать минуту</button>
          <a class="alt" href="/help">Нужна помощь сейчас</a>
        </>
      ) : (
        <>
          <label class="check"><input type="checkbox" id="c18" /><span class="box" aria-hidden="true"></span><span>Мне есть 18&nbsp;лет</span></label>
          <label class="check"><input type="checkbox" id="cdata" /><span class="box" aria-hidden="true"></span><span>Согласен(на) на&nbsp;обработку того, что я&nbsp;пишу о&nbsp;самочувствии. <a href="/privacy">Как это устроено</a></span></label>
          <button class="start" type="button" disabled>Начать</button>
          <p class="g-err" role="alert" hidden>Не получилось связаться с&nbsp;Inlo. Проверь интернет и&nbsp;нажми ещё раз.</p>
        </>
      )}
    </section>

    <section class="log" aria-live="polite" aria-label="Переписка с Inlo"></section>

    <div class="pin" role="region" aria-label="Живые люди рядом" hidden>
      <a class="call urgent" href="tel:112"><span><small>Экстренно</small><b>112</b></span><i aria-hidden="true"></i></a>
      <a class="call" href="tel:+74959895050"><span><small>Психологи МЧС, 24/7</small><b>+7&nbsp;495&nbsp;989‑50‑50</b></span><i aria-hidden="true"></i></a>
    </div>

    <div class="chips" role="group" aria-label="Быстрый ответ">
      <button type="button" data-say="Мне тревожно">Мне тревожно</button>
      <button type="button" data-say="Не могу уснуть">Не могу уснуть</button>
      <button type="button" data-say="Хочу просто выговориться">Хочу выговориться</button>
      <button type="button" data-act="breathe">Подышать минуту</button>
    </div>

    <form class="composer" autocomplete="off">
      <label class="sr" for="q">Сообщение для Inlo</label>
      <textarea id="q" rows="1" maxlength="2000" placeholder="Сообщение" enterkeyhint="send"></textarea>
      <button class="send" type="submit" aria-label="Отправить" disabled>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19V6m0 0l-6 6m6-6l6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </form>

    <dialog class="sheet" aria-labelledby="br-h">
      <p class="br-step" id="br-h" aria-live="polite">Приготовься</p>
      <div class="br-cloud" aria-hidden="true"><MiniCloud size={150} sleepy /></div>
      <p class="br-count" aria-hidden="true"></p>
      <div class="br-progress" aria-hidden="true"><i></i></div>
      <button class="br-close" type="button">Хватит</button>
    </dialog>

    <dialog class="plus" aria-labelledby="plus-h">
      <div class="p-head">
        <span class="p-cloud" aria-hidden="true"><MiniCloud size={44} /></span>
        <h2 id="plus-h">Inlo Plus</h2>
        <p class="p-state">Сейчас у тебя бесплатная версия</p>
      </div>
      <div class="tiers">
        <section class="tier">
          <h3>Бесплатно</h3>
          <ul>
            <li>Текстовый чат с&nbsp;Inlo</li>
            <li>Несколько голосовых ответов на&nbsp;пробу</li>
            <li>Подышать вместе</li>
            <li>Номера помощи 24/7, всегда и&nbsp;без лимитов</li>
          </ul>
        </section>
        <section class="tier hi">
          <h3>Plus</h3>
          <ul>
            <li>Inlo отвечает голосом, без ограничений</li>
            <li>История разговоров сохраняется</li>
            <li>Всё, что есть в&nbsp;бесплатной версии</li>
          </ul>
        </section>
      </div>
      <form class="code" autocomplete="off">
        <label for="code-in">Код доступа</label>
        <div class="code-row">
          <input id="code-in" name="code" placeholder="MIRA-TEST-XXXX" autocapitalize="characters" spellcheck="false" maxlength="40" />
          <button type="submit">Активировать</button>
        </div>
        <p class="code-msg" role="status"></p>
      </form>
      <p class="p-note">Оплата появится к&nbsp;запуску. Тестировщикам код выдаёт команда Inlo.</p>
      <button class="p-close" type="button">Закрыть</button>
    </dialog>
  </div>
</Base>

<script>
  type Msg = { who: 'me' | 'mira'; text: string; crisis?: boolean; voice?: string; note?: 'voice-limit' | 'text-limit' };
  const API = (import.meta.env.PUBLIC_MIRA_API || '').replace(/\/$/, '');
  const root = document.querySelector<HTMLElement>('.chat')!;
  const log = root.querySelector<HTMLElement>('.log')!;
  const form = root.querySelector<HTMLFormElement>('.composer')!;
  const input = form.querySelector('textarea')!;
  const send = form.querySelector<HTMLButtonElement>('.send')!;
  const chips = root.querySelector<HTMLElement>('.chips')!;
  const status = root.querySelector<HTMLElement>('.status')!;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const tg = (window as any).Telegram?.WebApp;
  const KEY = 'mira-chat', CRISIS = 'mira-crisis', TOKEN = 'mira-token';
  const pin = root.querySelector<HTMLElement>('.pin')!;

  const store = {
    get: (k: string, s: Storage) => { try { return s.getItem(k); } catch { return null; } },
    set: (k: string, v: string, s: Storage) => { try { s.setItem(k, v); } catch {} },
    del: (k: string, s: Storage) => { try { s.removeItem(k); } catch {} },
  };

  // ── Telegram: тема, высота, хаптика ──────────────────────────────
  const haptic = (kind: 'send' | 'warn') => {
    try { kind === 'send' ? tg?.HapticFeedback?.impactOccurred('light') : tg?.HapticFeedback?.notificationOccurred('warning'); } catch {}
  };
  if (tg) {
    tg.ready();
    tg.expand();
    tg.disableVerticalSwipes?.();
    const applyTheme = () => {
      const p = tg.themeParams || {}, s = document.documentElement.style;
      const map: Record<string, string | undefined> = {
        '--bg': p.bg_color, '--chat-bg': p.bg_color, '--ink': p.text_color, '--muted': p.hint_color,
        '--accent': p.button_color, '--accent-ink': p.button_text_color, '--bubble': p.secondary_bg_color, '--surface': p.secondary_bg_color,
      };
      for (const [k, v] of Object.entries(map)) if (v) s.setProperty(k, v);
      document.documentElement.classList.toggle('tg-dark', tg.colorScheme === 'dark');
      try { tg.setHeaderColor?.('bg_color'); tg.setBackgroundColor?.('bg_color'); } catch {}
    };
    applyTheme();
    tg.onEvent?.('themeChanged', applyTheme);
  }

  // ── Сообщения ────────────────────────────────────────────────────
  let msgs: Msg[] = JSON.parse(store.get(KEY, sessionStorage) || '[]');
  const save = () => store.set(KEY, JSON.stringify(msgs.slice(-60)), sessionStorage);

  // Номера и ссылки в ответах делаем нажимаемыми; HTML из ответа модели не вставляем никогда
  function richText(el: HTMLElement, text: string) {
    const re = /(https?:\/\/[^\s)]+|\+7\s?495\s?989[-‑\s]?50[-‑\s]?50|\b112\b)/g;
    let last = 0;
    for (const m of text.matchAll(re)) {
      el.append(text.slice(last, m.index));
      const a = document.createElement('a');
      const v = m[0];
      a.href = v.startsWith('http') ? v : v === '112' ? 'tel:112' : 'tel:+74959895050';
      a.textContent = v.replace(/^https?:\/\/(www\.heyinlo\.com|heyinlo\.com|mira-plum-mu\.vercel\.app)/, '') || v;
      el.append(a);
      last = (m.index || 0) + v.length;
    }
    el.append(text.slice(last));
  }

  const HELP_LINE = /^(112 —|\+7 495 989-50-50 —|Все проверенные номера:).*$/gm;
  function bubble(m: Msg, animate = true) {
    if (m.note) return limitCard(m.note, animate);
    const row = document.createElement('div');
    row.className = `row ${m.who}`;
    const prev = log.lastElementChild;
    if (prev?.classList.contains(m.who)) prev.classList.add('cont');
    const b = document.createElement('div');
    b.className = 'b';
    // В кризисном ответе номера уже закреплены кнопками над полем ввода, строки с ними из текста убираем
    const text = m.crisis ? m.text.replace(HELP_LINE, '').replace(/:\s*\n\s*\n/g, ', номера внизу.\n\n').replace(/\n{3,}/g, '\n\n').trim() : m.text;
    richText(b, text);
    if (m.voice) b.prepend(voiceButton(m.voice));
    row.append(b);
    if (animate && !reduce) row.classList.add('pop');
    log.append(row);
    scrollDown();
    return row;
  }

  // Голосовой ответ: кнопка в пузыре, играет один файл за раз
  let playing: HTMLAudioElement | null = null;
  function voiceButton(src: string) {
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'vbtn';
    btn.setAttribute('aria-label', 'Послушать ответ');
    btn.innerHTML = '<i aria-hidden="true"></i><span>Голос</span>';
    const audio = new Audio(src.startsWith('/') ? `${API}${src}` : src);
    audio.preload = 'none';
    audio.addEventListener('ended', () => btn.classList.remove('on'));
    audio.addEventListener('pause', () => btn.classList.remove('on'));
    btn.addEventListener('click', () => {
      if (!audio.paused) { audio.pause(); return; }
      playing?.pause();
      playing = audio;
      audio.play().then(() => btn.classList.add('on')).catch(() => {});
    });
    return btn;
  }

  // Пробные голосовые ответы закончились: мягко говорим один раз, без счётчиков
  function limitCard(kind: 'voice-limit' | 'text-limit', animate = true) {
    const row = document.createElement('div');
    row.className = 'row note';
    row.innerHTML = kind === 'voice-limit'
      ? `<div class="limit"><b>Дальше я отвечаю текстом</b><span>Голосовые ответы на пробу закончились. В Inlo Plus я говорю голосом без ограничений, и история сохраняется.</span><button type="button" data-act="plus">Подробнее</button></div>`
      : `<div class="limit"><b>Продолжим завтра?</b><span>Бесплатные сообщения на сегодня закончились. В Inlo Plus можно говорить без ограничений. Если тяжело прямо сейчас, кнопка «Помощь» сверху работает всегда.</span><button type="button" data-act="plus">Подробнее</button></div>`;
    if (animate && !reduce) row.classList.add('pop');
    log.append(row);
    scrollDown();
    return row;
  }

  function scrollDown() { requestAnimationFrame(() => log.scrollTo({ top: log.scrollHeight, behavior: reduce ? 'auto' : 'smooth' })); }

  function push(m: Msg) { msgs.push(m); save(); bubble(m); if (m.crisis) pinHelp(true); }

  // Кризисный режим: номера закреплены до конца сессии, облачко замирает
  function pinHelp(fresh = false) {
    if (fresh) { haptic('warn'); store.set(CRISIS, '1', sessionStorage); }
    pin.hidden = false;
    root.classList.add('crisis');
  }
  if (store.get(CRISIS, sessionStorage)) pinHelp();

  function typing() {
    const row = document.createElement('div');
    row.className = 'row mira typing pop';
    row.innerHTML = '<div class="b" aria-label="Inlo печатает"><i></i><i></i><i></i></div>';
    log.append(row);
    status.textContent = 'печатает…';
    root.classList.add('thinking');
    scrollDown();
    return () => { row.remove(); status.textContent = 'AI, не психолог'; root.classList.remove('thinking'); };
  }

  // ── Транспорт: API бота, контракт в bot/API.md ─────────────────
  let token = store.get(TOKEN, localStorage) || '';
  const SLOW = 'Давай чуть притормозим, я не успеваю. Напиши мне через пару минут.';
  const FAIL = 'Извини, я сейчас не могу ответить: что-то сломалось у меня внутри. Попробуй через минуту.';

  async function call(path: string, body?: object) {
    const res = await fetch(`${API}${path}`, {
      method: body ? 'POST' : 'GET',
      headers: { ...(body ? { 'content-type': 'application/json' } : {}), ...(token ? { authorization: `Bearer ${token}` } : {}) },
      body: body ? JSON.stringify(body) : undefined,
      signal: AbortSignal.timeout(30000),
    });
    let data: any = {};
    try { data = await res.json(); } catch {}
    return { status: res.status, data };
  }

  /** Открывает сессию: в Telegram по подписи initData, на сайте по анонимному токену. Возвращает, дано ли согласие. */
  async function session() {
    const body = tg?.initData ? { channel: 'tg', initData: tg.initData } : { channel: 'web', ...(token ? { token } : {}) };
    const { status, data } = await call('/v1/session', body);
    if (status !== 200 || !data.token) throw new Error(`session ${status}`);
    token = data.token;
    if (!tg?.initData) store.set(TOKEN, token, localStorage);
    setPlan(data.plan, data.premiumUntil);
    return !!data.consented;
  }

  let pending = '';
  let limitPending: false | 'voice' | 'text' = false;
  const VOICES = ['f', 'm', 'off'] as const, VOICE_LABEL = { f: 'женский', m: 'мужской', off: 'выключен' };
  let voicePref: (typeof VOICES)[number] = (VOICES as readonly string[]).includes(store.get('mira-voice', localStorage) || '') ? (store.get('mira-voice', localStorage) as any) : 'f';
  async function ask(text: string): Promise<Msg | null> {
    let r = await call('/v1/chat', { text, voice: voicePref });
    if (r.status === 401) { await session(); r = await call('/v1/chat', { text, voice: voicePref }); }
    if (r.status === 429) return { who: 'mira', text: SLOW };
    if (r.status !== 200) return { who: 'mira', text: FAIL };
    // Сервер перезапускался и забыл согласие: снова ворота, после них отправим это же сообщение
    if (r.data.needConsent) { pending = text; showGate(); return null; }
    // Номера закрепляем только при настоящей опасности: острый кризис или модель сама поняла, что человеку угрожает риск.
    // На «мне плохо» (distress) Inlo просто отвечает, контакты остаются строкой в тексте.
    const risk = r.data.risk as string | undefined;
    const serious = risk ? risk === 'acute' || risk === 'flagged' : !!r.data.crisis;
    if (r.data.limit === 'voice' || r.data.limit === 'text') limitPending = r.data.limit;
    return { who: 'mira', text: r.data.text || FAIL, crisis: serious, voice: r.data.voice?.url };
  }

  let busy = false;
  async function say(text: string, echo = true) {
    text = text.trim();
    if (!text || busy) return;
    busy = true;
    haptic('send');
    root.classList.add('talking');
    if (echo) push({ who: 'me', text });
    input.value = ''; grow(); sync();
    const done = typing();
    const t0 = performance.now();
    let reply: Msg | null;
    try { reply = await ask(text); } catch { reply = { who: 'mira', text: FAIL }; }
    // Мгновенный ответ выглядит как робот: даём «подумать» хотя бы полсекунды
    const wait = 650 - (performance.now() - t0);
    if (wait > 0 && !reduce) await new Promise((r) => setTimeout(r, wait));
    done();
    if (reply) push(reply);
    if (limitPending && !store.get(`mira-limit-${limitPending}`, sessionStorage)) {
      const kind = limitPending;
      store.set(`mira-limit-${kind}`, '1', sessionStorage);
      setTimeout(() => push({ who: 'mira', text: '', note: `${kind}-limit` }), reduce ? 0 : 500);
    }
    limitPending = false;
    busy = false;
    sync();
  }

  // ── Поле ввода ───────────────────────────────────────────────────
  function grow() { input.style.height = 'auto'; input.style.height = `${Math.min(input.scrollHeight, 140)}px`; }
  function sync() { send.disabled = busy || !input.value.trim(); root.classList.toggle('has-text', !!input.value.trim()); }
  input.addEventListener('input', () => { grow(); sync(); });
  input.addEventListener('keydown', (e) => {
    // Enter отправляет на компьютере, на телефоне Enter это перенос строки
    if (e.key === 'Enter' && !e.shiftKey && !e.isComposing && matchMedia('(pointer: fine)').matches) { e.preventDefault(); form.requestSubmit(); }
  });
  form.addEventListener('submit', (e) => { e.preventDefault(); say(input.value); });
  chips.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button');
    if (b && !b.dataset.act) say(b.dataset.say || '');
  });
  // «Подышать минуту» живёт в чипах, в меню и на экране «скоро»
  root.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('.gate [data-act=breathe], .chips [data-act=breathe]')) breathe();
  });

  // ── Приветствие и ворота ─────────────────────────────────────────
  function greet(text?: string) {
    const night = document.documentElement.classList.contains('night');
    push({ who: 'mira', text: text || (night
      ? 'Не спится? Я рядом. Расскажи, что крутится в голове, или давай просто подышим.'
      : 'Я рядом. Расскажи, что у тебя сейчас происходит. Можно с любого места, даже одним словом.') });
  }

  async function openChat(first?: string) {
    // Ворота уходят, лента проявляется: один плавный переход вместо щелчка
    const show = () => root.classList.add('ready');
    if (!root.classList.contains('ready') && !reduce && document.startViewTransition) document.startViewTransition(show); else show();
    log.innerHTML = '';
    // В Plus переписка хранится на сервере: подтягиваем её, если в этой вкладке пусто
    if (!msgs.length && root.classList.contains('premium')) {
      try {
        const r = await call('/v1/history');
        if (r.status === 200 && Array.isArray(r.data.messages)) {
          msgs = r.data.messages.map((m: any) => ({ who: m.role === 'user' ? 'me' : 'mira', text: String(m.text || '') })).filter((m: Msg) => m.text);
          save();
        }
      } catch {}
    }
    msgs.forEach((m) => bubble(m, false));
    if (!msgs.length) setTimeout(() => greet(first), reduce ? 0 : 420);
    if (matchMedia('(pointer: fine)').matches) setTimeout(() => input.focus(), 500);
    if (pending) { const t = pending; pending = ''; setTimeout(() => say(t, false), 600); }
  }

  const c18 = root.querySelector<HTMLInputElement>('#c18');
  const cdata = root.querySelector<HTMLInputElement>('#cdata');
  const start = root.querySelector<HTMLButtonElement>('.start')!;
  const gErr = root.querySelector<HTMLElement>('.g-err');
  function showGate() {
    root.classList.remove('ready');
    if (c18 && cdata) { c18.checked = cdata.checked = false; start.disabled = true; }
  }

  if (API && c18 && cdata) {
    const gateSync = () => { start.disabled = !(c18.checked && cdata.checked); };
    c18.addEventListener('change', gateSync); cdata.addEventListener('change', gateSync);
    start.addEventListener('click', async () => {
      start.disabled = true; gErr!.hidden = true;
      haptic('send');
      try {
        if (!token) await session();
        let r = await call('/v1/consent', { adult: true, health: true });
        if (r.status === 401) { await session(); r = await call('/v1/consent', { adult: true, health: true }); }
        if (r.status !== 200) throw new Error(`consent ${r.status}`);
        openChat(r.data.text);
      } catch {
        gErr!.hidden = false; gateSync();
      }
    });
    // Кто уже согласился (в боте или раньше на сайте), ворота второй раз не видит
    session().then((ok) => { if (ok) openChat(); }).catch(() => {});
  }

  // ── Меню ─────────────────────────────────────────────────────────
  const more = root.querySelector<HTMLButtonElement>('.more')!;
  const menu = root.querySelector<HTMLElement>('.menu')!;
  const toggleMenu = (open = menu.hidden || menu.classList.contains('closing')) => {
    more.setAttribute('aria-expanded', String(open));
    if (open) { menu.classList.remove('closing'); menu.hidden = false; return; }
    if (menu.hidden || reduce) { menu.hidden = true; return; }
    menu.classList.add('closing'); // меню сворачивается к кнопке, а не исчезает щелчком
    setTimeout(() => { if (menu.classList.contains('closing')) { menu.classList.remove('closing'); menu.hidden = true; } }, 170);
  };
  more.addEventListener('click', (e) => { e.stopPropagation(); toggleMenu(); });
  document.addEventListener('click', (e) => { if (!menu.hidden && !menu.classList.contains('closing') && !menu.contains(e.target as Node)) toggleMenu(false); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) { toggleMenu(false); more.focus(); } });
  menu.addEventListener('click', async (e) => {
    const act = (e.target as HTMLElement).closest<HTMLElement>('[data-act]')?.dataset.act;
    if (!act) return;
    if (act !== 'voice') toggleMenu(false);
    if (act === 'breathe') breathe();
    if (act === 'plus') openPlus();
    if (act === 'voice') { voicePref = VOICES[(VOICES.indexOf(voicePref) + 1) % VOICES.length]; store.set('mira-voice', voicePref, localStorage); syncVoice(); }
    if (act === 'reset' && root.classList.contains('ready')) {
      let text: string | undefined;
      try { text = (await call('/v1/reset', {})).data.text; } catch {}
      msgs = []; save(); log.innerHTML = ''; root.classList.remove('talking');
      greet(text);
    }
  });

  // ── Листы: уходят анимацией, на телефоне смахиваются вниз, как в iOS ──
  function dismiss(d: HTMLDialogElement) {
    if (!d.open || d.classList.contains('closing')) return;
    if (reduce) { d.close(); return; }
    d.classList.add('closing');
    const done = (e: AnimationEvent) => {
      if (e.target !== d) return;
      d.removeEventListener('animationend', done);
      d.classList.remove('closing'); d.style.transform = ''; d.close();
    };
    d.addEventListener('animationend', done);
  }
  function sheetBehaviour(d: HTMLDialogElement) {
    d.addEventListener('cancel', (e) => { e.preventDefault(); dismiss(d); });
    d.addEventListener('click', (e) => { if (e.target === d) dismiss(d); });
    let y0 = 0, t0 = 0, dy = 0, drag = false;
    d.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'mouse' || (e.target as HTMLElement).closest('input, button, a, label') || d.scrollTop > 0) return;
      drag = true; y0 = e.clientY; t0 = e.timeStamp; dy = 0; d.style.transition = 'none';
    });
    d.addEventListener('pointermove', (e) => {
      if (!drag) return;
      dy = Math.max(0, e.clientY - y0);
      d.style.transform = `translateY(${dy < 120 ? dy : 120 + (dy - 120) * .5}px)`; // дальше тянется туже
    });
    const end = (e: PointerEvent) => {
      if (!drag) return;
      drag = false; d.style.transition = '';
      const fast = dy / Math.max(1, e.timeStamp - t0) > .6;
      if (dy > 110 || (fast && dy > 30)) { haptic('send'); dismiss(d); }
      else { d.style.transform = ''; }
    };
    d.addEventListener('pointerup', end);
    d.addEventListener('pointercancel', end);
  }

  // ── Inlo Plus: тариф и код доступа ───────────────────────────────
  const plusSheet = root.querySelector<HTMLDialogElement>('.plus')!;
  const badge = root.querySelector<HTMLElement>('.plus-badge')!;
  const pState = plusSheet.querySelector<HTMLElement>('.p-state')!;
  const codeForm = plusSheet.querySelector<HTMLFormElement>('.code')!;
  const codeIn = codeForm.querySelector('input')!;
  const codeMsg = codeForm.querySelector<HTMLElement>('.code-msg')!;

  function setPlan(plan?: string, until?: string) {
    const premium = plan === 'premium';
    badge.hidden = !premium;
    root.classList.toggle('premium', premium);
    const date = until ? new Date(until).toLocaleDateString('ru-RU', { day: 'numeric', month: 'long' }) : '';
    pState.textContent = premium ? `У тебя Inlo Plus${date ? ` до ${date}` : ''}` : 'Сейчас у тебя бесплатная версия';
    codeForm.hidden = premium;
  }
  const vLabel = root.querySelector<HTMLElement>('.v-label');
  function syncVoice() { if (vLabel) vLabel.textContent = VOICE_LABEL[voicePref]; }
  syncVoice();
  function openPlus() { codeMsg.textContent = ''; plusSheet.showModal(); }
  // Ссылка «У меня есть код» с главной ведёт на /chat#plus: сразу показываем лист с кодом
  if (API && location.hash === '#plus') { history.replaceState(null, '', location.pathname + location.search); setTimeout(openPlus, reduce ? 0 : 700); }
  plusSheet.querySelector('.p-close')!.addEventListener('click', () => dismiss(plusSheet));
  sheetBehaviour(plusSheet);
  log.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('[data-act=plus]')) openPlus(); });
  codeForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const code = codeIn.value.trim().toUpperCase();
    if (!code) return;
    codeMsg.className = 'code-msg';
    codeMsg.textContent = 'Проверяю…';
    try {
      if (!token) await session();
      const r = await call('/v1/redeem', { code });
      if (r.status === 200 && r.data.plan === 'premium') {
        setPlan(r.data.plan, r.data.premiumUntil);
        codeIn.value = '';
        codeMsg.classList.add('ok');
        codeMsg.textContent = 'Готово, Inlo Plus включён.';
        haptic('send');
      } else {
        codeMsg.classList.add('err');
        codeMsg.textContent = r.data.error === 'used_code' ? 'Этот код уже использован.' : r.status === 404 ? 'Коды пока не принимаются, попробуй позже.' : 'Такого кода нет. Проверь, нет ли опечатки.';
      }
    } catch {
      codeMsg.classList.add('err');
      codeMsg.textContent = 'Не получилось связаться с Inlo. Попробуй ещё раз.';
    }
  });

  // ── Подышать минуту: вдох 4, выдох 6, шесть кругов ───────────────
  const sheet = root.querySelector<HTMLDialogElement>('.sheet')!;
  const step = sheet.querySelector<HTMLElement>('.br-step')!;
  const count = sheet.querySelector<HTMLElement>('.br-count')!;
  const bar = sheet.querySelector<HTMLElement>('.br-progress i')!;
  let timer = 0;
  function breathe() {
    const IN = 4, OUT = 6, ROUNDS = 6, TOTAL = (IN + OUT) * ROUNDS;
    let t = -2; // две секунды «приготовься»
    sheet.showModal();
    sheet.classList.remove('in', 'out');
    step.textContent = 'Приготовься'; count.textContent = '';
    bar.style.transform = 'scaleX(0)';
    const tickFn = () => {
      t++;
      if (t >= TOTAL) return finish(true);
      if (t < 0) return;
      const inCycle = t % (IN + OUT);
      const inhale = inCycle < IN;
      if (inCycle === 0) { sheet.classList.add('in'); sheet.classList.remove('out'); step.textContent = 'Вдох'; }
      if (inCycle === IN) { sheet.classList.add('out'); sheet.classList.remove('in'); step.textContent = 'Выдох'; }
      count.textContent = String(inhale ? IN - inCycle : IN + OUT - inCycle);
      bar.style.transform = `scaleX(${(t + 1) / TOTAL})`;
    };
    timer = window.setInterval(tickFn, 1000);
  }
  function finish(done: boolean) {
    clearInterval(timer);
    dismiss(sheet);
    if (done && root.classList.contains('ready')) push({ who: 'mira', text: 'Ты молодец. Как ты сейчас, хоть немного спокойнее? Можем поговорить о том, что беспокоит.' });
  }
  sheet.querySelector('.br-close')!.addEventListener('click', () => finish(false));
  sheet.addEventListener('close', () => clearInterval(timer));
  sheetBehaviour(sheet);
</script>

