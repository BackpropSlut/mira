---
// Небо за облачком в блоке «Подышать». Меняется по фазе суток (класс на <html>):
// утро и день: солнце с переливающейся короной и плывущие облака; вечер: низкое тёплое солнце и первые звёзды;
// ночь: луна, мерцающие звёзды и редкие падающие звёзды. Объём даём градиентами и тенями, без картинок.
let seed = 7;
const rnd = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;
const stars = Array.from({ length: 46 }, () => ({
  x: (rnd() * 100).toFixed(1),
  y: (rnd() * 78).toFixed(1),
  s: (1 + rnd() * 1.8).toFixed(1),
  d: (rnd() * 6).toFixed(2),
  t: (3 + rnd() * 4).toFixed(1),
}));
// Облака: формы заранее отрисованы фрактальным шумом (public/sky, маски без цвета), цвет даёт фаза суток.
// Три слоя: освещённая масса, тень снизу, блик сверху. Плывут через всё небо, дальние меньше и медленнее.
// Маски вместо живых SVG-фильтров: так же реалистично, но браузер не пересчитывает шум в каждом кадре.
const clouds = [
  { s: 1, y: 4, w: 360, z: 'far', t: 200, d: -30 },
  { s: 3, y: 20, w: 300, z: 'far', t: 240, d: -150 },
  { s: 2, y: 34, w: 560, z: 'near', t: 130, d: -15 },
  { s: 1, y: 52, w: 480, z: 'near', t: 150, d: -95 },
  { s: 3, y: 12, w: 420, z: 'mid', t: 175, d: -60 },
];
---
<div class="sky" aria-hidden="true">
  <div class="stars">
    {stars.map((s) => <i style={`left:${s.x}%;top:${s.y}%;--s:${s.s}px;--d:${s.d}s;--t:${s.t}s`} />)}
  </div>
  <span class="shoot sh1"></span><span class="shoot sh2"></span><span class="shoot sh3"></span>
  <div class="orb-wrap">
    <div class="orb sun"><i class="rays"></i><i class="rays r2"></i><i class="corona"></i><i class="core"></i></div>
    <div class="orb moon"><i></i><i></i><i></i></div>
  </div>
  {clouds.map((c) => (
    <div class={`cl ${c.z}`} style={`top:${c.y}%;--w:${c.w}px;--t:${c.t}s;--d:${c.d}s;--m1:url(/sky/c${c.s}-base.webp);--m2:url(/sky/c${c.s}-shade.webp);--m3:url(/sky/c${c.s}-lite.webp)`}>
      <div class="cl-in"><i class="c-base"></i><i class="c-shade"></i><i class="c-lite"></i></div>
    </div>
  ))}
</div>

<style is:global>
  /* Цвета неба. --sky-k: сколько цвета неба подмешать к фону темы, чтобы текст оставался читаемым. */
  :root, .day { --sky-top:#9fd0f2; --sky-bot:#e8f4fb; --sky-k:62%; --puff-hi:#ffffff; --puff-lo:#d5e2ef; --puff-op:.95; --cl-lit:#ffffff; --cl-shade:#a9bbd3; --ray:rgba(255,240,190,.55); --star-op:0; --shoot-op:0;
    --sun-1:#fffbe6; --sun-2:#ffd86b; --sun-3:#f7b23b; --sun-glow:rgba(255,205,90,.45); --orb-x:78%; --orb-y:12%; --sun-op:1; --moon-op:0; }
  .morning { --sky-top:#f9cdb8; --sky-bot:#fdf0e6; --sky-k:58%; --puff-hi:#fff8f3; --puff-lo:#f2d6cb; --cl-lit:#fff7f1; --cl-shade:#e0b2a4; --ray:rgba(255,215,170,.55); --sun-1:#fffaf0; --sun-2:#ffcf8a; --sun-3:#f59e6b;
    --sun-glow:rgba(255,170,120,.45); --orb-x:12%; --orb-y:22%; }
  .evening { --sky-top:#c9b4e6; --sky-bot:#f7d4c8; --sky-k:58%; --puff-hi:#fff0f2; --puff-lo:#d9c2e2; --cl-lit:#fff1f3; --cl-shade:#b4a0d2; --ray:rgba(255,190,160,.5); --star-op:.45; --shoot-op:.6;
    --sun-1:#fff2dc; --sun-2:#ffa977; --sun-3:#e86a6a; --sun-glow:rgba(255,140,110,.45); --orb-x:80%; --orb-y:40%; }
  .night { --sky-top:#0b1430; --sky-bot:#1e2540; --sky-k:80%; --puff-hi:#4a5576; --puff-lo:#1f2640; --puff-op:.55; --cl-lit:#59668a; --cl-shade:#161c36; --star-op:1; --shoot-op:1;
    --orb-x:76%; --orb-y:10%; --sun-op:0; --moon-op:1; }
  @media (prefers-color-scheme: dark) {
    :root:not(.plain):not(.night) { --sky-k:22%; --puff-hi:#7d8aa6; --puff-lo:#3a4560; --puff-op:.5; --cl-lit:#8d99b6; --cl-shade:#2f3954; --star-op:.6; }
  }

  .sky { position:absolute; inset:0; overflow:hidden; pointer-events:none; z-index:0;
    /* Небо проявляется из фона страницы и в него же растворяется: без жёстких краёв */
    background:linear-gradient(180deg, transparent, color-mix(in srgb, var(--sky-top) calc(var(--sky-k) * .5), var(--bg)) 14%, color-mix(in srgb, var(--sky-top) var(--sky-k), var(--bg)) 30%, color-mix(in srgb, var(--sky-bot) var(--sky-k), var(--bg)) 62%, transparent);
    transition: background 2s ease; }

  /* Звёзды */
  .stars { position:absolute; inset:0; opacity:var(--star-op); transition:opacity 2s ease; }
  .stars i { position:absolute; width:var(--s); height:var(--s); border-radius:50%; background:#fff;
    box-shadow:0 0 6px 1px rgba(220,230,255,.7); animation:twinkle var(--t) ease-in-out var(--d) infinite; }
  @keyframes twinkle { 0%,100% { opacity:.25; transform:scale(.8) } 50% { opacity:1; transform:scale(1.15) } }

  /* Падающие звёзды: длинный цикл, видны только короткий миг */
  .shoot { position:absolute; width:140px; height:2px; border-radius:2px; opacity:0;
    background:linear-gradient(90deg, rgba(255,255,255,0), rgba(255,255,255,.95)); filter:drop-shadow(0 0 6px rgba(200,220,255,.9));
    transform:rotate(-24deg); animation:shoot 11s linear infinite; }
  .shoot::after { content:""; position:absolute; right:-2px; top:-2px; width:6px; height:6px; border-radius:50%; background:#fff; box-shadow:0 0 10px 3px rgba(220,235,255,.9); }
  .sh1 { left:58%; top:6%; animation-delay:2s; }
  .sh2 { left:18%; top:16%; animation-duration:17s; animation-delay:8s; }
  .sh3 { left:40%; top:2%; animation-duration:23s; animation-delay:14s; }
  @keyframes shoot {
    0% { opacity:0; transform:rotate(-24deg) translateX(0) }
    2% { opacity:var(--shoot-op) }
    7% { opacity:0; transform:rotate(-24deg) translateX(-260px) translateY(0) }
    100% { opacity:0; transform:rotate(-24deg) translateX(-260px) }
  }

  /* Солнце и луна: шар с объёмом за счёт смещённого радиального градиента */
  .orb-wrap { position:absolute; left:var(--orb-x); top:var(--orb-y); width:clamp(64px, 9vw, 104px); aspect-ratio:1;
    transition:left 2s ease, top 2s ease; }
  .orb { position:absolute; inset:0; border-radius:50%; transition:opacity 2s ease; }
  /* Солнце: шар с объёмом, вокруг дышит корона, лучи медленно вращаются в разные стороны, по шару скользит блик */
  .sun { opacity:var(--sun-op); }
  .sun i { position:absolute; border-radius:50%; }
  .sun .core { inset:0; background:radial-gradient(circle at 36% 32%, var(--sun-1), var(--sun-2) 48%, var(--sun-3) 100%);
    box-shadow:0 0 40px 12px var(--sun-glow), inset -8px -10px 22px rgba(190,90,20,.22); overflow:hidden; }
  .sun .core::after { content:""; position:absolute; inset:-40%; border-radius:50%;
    background:linear-gradient(115deg, transparent 35%, rgba(255,255,255,.55) 48%, transparent 60%); animation:sheen 7s ease-in-out infinite; }
  .sun .corona { inset:-55%; background:radial-gradient(closest-side, var(--sun-glow), color-mix(in srgb, var(--sun-glow) 35%, transparent) 55%, transparent);
    animation:corona 6s ease-in-out infinite; }
  .sun .rays { inset:-160%; background:repeating-conic-gradient(from 0deg, transparent 0deg, var(--ray) 5deg, transparent 10deg, transparent 22deg);
    -webkit-mask:radial-gradient(closest-side, #000 14%, rgba(0,0,0,.4) 40%, transparent 70%); mask:radial-gradient(closest-side, #000 14%, rgba(0,0,0,.4) 40%, transparent 70%);
    opacity:.55; animation:spin 110s linear infinite; will-change:transform; }
  .sun .r2 { inset:-125%; opacity:.45; animation-duration:170s; animation-direction:reverse; }
  @keyframes spin { to { transform:rotate(360deg) } }
  @keyframes corona { 0%,100% { transform:scale(1); opacity:.85 } 50% { transform:scale(1.14); opacity:1 } }
  @keyframes sheen { 0%,15% { translate:-60% -20% } 60%,100% { translate:60% 20% } }
  .moon { opacity:var(--moon-op);
    background:radial-gradient(circle at 34% 30%, #fffef6, #ece9db 45%, #b8b5a6 100%);
    box-shadow:0 0 36px 10px rgba(210,225,255,.28), 0 0 110px 40px rgba(150,170,255,.14), inset -10px -12px 24px rgba(40,40,70,.35); }
  .moon i { position:absolute; border-radius:50%; background:rgba(150,146,130,.35); box-shadow:inset 2px 2px 4px rgba(80,76,66,.35), inset -1px -1px 2px rgba(255,255,255,.4); }
  .moon i:nth-child(1) { width:22%; height:22%; left:52%; top:22%; }
  .moon i:nth-child(2) { width:14%; height:14%; left:28%; top:56%; }
  .moon i:nth-child(3) { width:10%; height:10%; left:62%; top:64%; }
  @keyframes glow { 0%,100% { filter:brightness(1) } 50% { filter:brightness(1.06) saturate(1.1) } }

  /* Облака плывут слева направо через всё небо. Двигается только слой, маска не перерисовывается. */
  .cl { position:absolute; left:0; width:var(--w); aspect-ratio:58 / 37; opacity:var(--puff-op);
    animation:sail var(--t) linear var(--d) infinite; will-change:transform; transition:opacity 2s ease; }
  .cl-in { position:absolute; inset:0; }
  .cl i { position:absolute; inset:0; -webkit-mask-size:100% 100%; mask-size:100% 100%; -webkit-mask-repeat:no-repeat; mask-repeat:no-repeat; transition:background-color 2s ease; }
  .c-base { background:var(--cl-lit); -webkit-mask-image:var(--m1); mask-image:var(--m1); }
  .c-shade { background:var(--cl-shade); -webkit-mask-image:var(--m2); mask-image:var(--m2); opacity:.5; }
  .c-lite { background:#fff; -webkit-mask-image:var(--m3); mask-image:var(--m3); opacity:.85; }
  .night .c-lite { opacity:.18; }
  .cl.far { opacity:calc(var(--puff-op) * .7); }
  .cl.far .cl-in { transform:scale(.7); }
  .cl.mid .cl-in { transform:scale(.85); }
  @keyframes sail { from { transform:translateX(-50vw) } to { transform:translateX(115vw) } }

  /* Лёгкий параллакс при прокрутке там, где браузер умеет scroll-driven анимации */
  @supports (animation-timeline: view()) {
    .orb-wrap { animation:par-orb linear both; animation-timeline:view(); }
    .cl.near .cl-in { animation:par-near linear both; animation-timeline:view(); }
    @keyframes par-orb { from { translate:0 40px } to { translate:0 -40px } }
    @keyframes par-near { from { translate:0 -30px } to { translate:0 30px } }
  }

  /* На телефоне солнце/луна меньше и выше, чтобы не наезжать на заголовок */
  @media (max-width: 640px) { .orb-wrap { width:48px; top:calc(var(--orb-y) * .35); left:min(var(--orb-x), 82%); } .cl .cl-in { transform:scale(.62); } .cl.mid .cl-in { transform:scale(.52); } .cl.far .cl-in { transform:scale(.44); } .cl.near { opacity:calc(var(--puff-op) * .75); } }

  @media (prefers-reduced-motion: reduce) {
    .stars i, .shoot, .sun i, .sun .core::after, .orb-wrap, .cl-in { animation:none !important; }
    .cl { animation-play-state:paused; } /* облака стоят на местах, разбросанные по небу */
    .shoot { display:none; }
  }
</style>
