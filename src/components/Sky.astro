---
// Небо за облачком в «Подышать», по мотивам пресетов Apple Weather. Фаза суток задаётся классом на <html>.
// Глубокий градиент на всю секцию; тонкие перистые пряди медленно тянутся по диагонали;
// ночью густые мелкие звёзды, днём солнце с мягким ореолом и бликами линзы, кучевые облака плывут поверху.
// Текст и кнопки внутри становятся белыми на «матовом стекле», как карточки в Погоде.
let seed = 7;
const rnd = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;
// Звёзды рисуем тенями одного пикселя: сотни точек без сотен элементов. Поле 2400×1400, секция его обрезает.
const field = (n: number, size: number, alpha: [number, number]) =>
  Array.from({ length: n }, () => {
    const a = (alpha[0] + rnd() * (alpha[1] - alpha[0])).toFixed(2);
    return `${Math.round(rnd() * 2400)}px ${Math.round(rnd() * 1400)}px 0 ${size}px rgba(255,255,255,${a})`;
  }).join(',');
const starLayers = [
  { sh: field(150, 0, [0.35, 0.8]), t: 7, d: 0 },
  { sh: field(150, 0, [0.35, 0.8]), t: 0, d: 0 },
  { sh: field(70, 0.4, [0.55, 0.95]), t: 6, d: -1.5 },
  { sh: field(70, 0.4, [0.55, 0.95]), t: 0, d: 0 },
];
const bright = Array.from({ length: 22 }, () => ({
  x: (rnd() * 100).toFixed(1),
  y: (rnd() * 92).toFixed(1),
  s: (1.6 + rnd() * 1.2).toFixed(1),
  d: (rnd() * -8).toFixed(2),
  t: (4 + rnd() * 5).toFixed(1),
}));
// Кучевые облака: маски заранее отрисованы фрактальным шумом (public/sky), цвет даёт фаза. Только в верхней части неба.
const clouds = [
  { s: 1, y: 2, w: 380, z: 'far', t: 210, d: -40 },
  { s: 3, y: 10, w: 440, z: 'mid', t: 170, d: -120 },
  { s: 2, y: 4, w: 520, z: 'near', t: 150, d: -70 },
];
// bare: только фон, без белого текста у родителя (родитель сам решает, что стоит на небе, через .on-sky)
const { bare = false } = Astro.props;
---
<div class:list={['sky', { bare }]} aria-hidden="true">
  <div class="stars">
    {starLayers.map((l) => <i class={l.t ? 'sf tw' : 'sf'} style={`box-shadow:${l.sh};--t:${l.t}s;--d:${l.d}s`} />)}
    {bright.map((s) => <i class="sb" style={`left:${s.x}%;top:${s.y}%;--s:${s.s}px;--d:${s.d}s;--t:${s.t}s`} />)}
  </div>
  <div class="horizon"></div>
  <div class="orb-wrap">
    <div class="sun"><i class="bloom"></i><i class="halo"></i><i class="core"></i></div>
    <i class="ghost g1"></i><i class="ghost g2"></i><i class="ghost g3"></i>
  </div>
  <div class="wisps">
    <i class="ws"></i>
  </div>
  {clouds.map((c) => (
    <div class={`cl ${c.z}`} style={`top:${c.y}%;--w:${c.w}px;--t:${c.t}s;--d:${c.d}s;--m1:url(/sky/c${c.s}-base.webp);--m2:url(/sky/c${c.s}-shade.webp);--m3:url(/sky/c${c.s}-lite.webp)`}>
      <div class="cl-in"><i class="c-base"></i><i class="c-shade"></i><i class="c-lite"></i></div>
    </div>
  ))}
</div>

<script>
  const io = new IntersectionObserver((es) => es.forEach((e) => e.target.classList.toggle('off', !e.isIntersecting)), { rootMargin: '120px' });
  document.querySelectorAll('.sky').forEach((el) => io.observe(el));
  // Маски облаков (~220 КБ) грузим после загрузки страницы: сначала текст и градиент неба, облака проявляются следом
  const show = () => document.documentElement.classList.add('sky-in');
  const idle = () => ('requestIdleCallback' in window ? requestIdleCallback(show, { timeout: 1500 }) : setTimeout(show, 200));
  if (document.readyState === 'complete') idle(); else addEventListener('load', idle, { once: true });
</script>

<style is:global>
  /* Палитры фаз. Небо одно и то же в светлой и тёмной теме системы, как в Погоде. */
  :root, .day { --sky:linear-gradient(180deg, #1f5bbf 0%, #3479d2 52%, #5f9ee0 100%); --hz:rgba(170,215,255,.35);
    --star-op:0; --sun-op:1; --wisp:#ffffff; --wisp-op:.38; --puff-op:.92; --cl-lit:#ffffff; --cl-shade:#9db6d8;
    --sun-core:#fffef6; --sun-bloom:rgba(255,250,228,.55); --orb-x:16%; --orb-y:8%; --gx:1; --glass:rgba(255,255,255,.16); --ink-on:#14306b; }
  .morning { --sky:linear-gradient(180deg, #24427f 0%, #5b6ea8 38%, #b88a9c 72%, #eeaa84 100%); --hz:rgba(255,190,140,.45);
    --star-op:.18; --wisp:#ffe6d8; --wisp-op:.32; --puff-op:.8; --cl-lit:#fff1e8; --cl-shade:#a88fae;
    --sun-core:#fff6e4; --sun-bloom:rgba(255,200,150,.6); --orb-x:14%; --orb-y:62%; --gx:1; --glass:rgba(255,255,255,.14); --ink-on:#2a2f63; }
  .evening { --sky:linear-gradient(180deg, #1b2150 0%, #43397a 38%, #9a5b7f 72%, #e2865f 100%); --hz:rgba(255,150,100,.5);
    --star-op:.45; --wisp:#ffc9b8; --wisp-op:.28; --puff-op:.6; --cl-lit:#ffd6c8; --cl-shade:#5e4a82;
    --sun-core:#fff0d8; --sun-bloom:rgba(255,150,100,.6); --orb-x:80%; --orb-y:70%; --gx:-1; --glass:rgba(255,255,255,.12); --ink-on:#2b2456; }
  .night { --sky:linear-gradient(180deg, #0d1028 0%, #181b3a 50%, #24264a 100%); --hz:rgba(90,100,170,.25);
    --star-op:1; --sun-op:0; --wisp:#c9cdf0; --wisp-op:.13; --puff-op:0; --glass:rgba(255,255,255,.08); --ink-on:#151935; }

  .sky { position:absolute; inset:0; overflow:hidden; pointer-events:none; z-index:0; background:var(--sky); }
  /* Пока страница грузится, слоёв с картинками нет совсем: браузер не качает маски и не задерживает первый экран.
     Без JS (нет класса .js) облака видны сразу. Появляются мягко за счёт своих transition по opacity */
  .js:not(.sky-in) .sky :is(.wisps, .cl) { display:none; }
  @starting-style { .sky-in .sky :is(.wisps, .cl) { opacity:0; } }
  /* Небо за пределами экрана не анимируем: на странице их два, телефону это заметно */
  .sky.off * { animation-play-state:paused !important; }

  /* Секция с небом: белый текст и «матовое стекло» вместо поверхностей темы */
  :is(:has(> .sky:not(.bare)), .on-sky) { --glass-bg:var(--glass); --glass-rim:rgba(255,255,255,.35); --glass-edge:transparent; --glass-hi:rgba(255,255,255,.28);
    --ink:#fff; --muted:rgba(255,255,255,.8); --line:rgba(255,255,255,.2); --surface:var(--glass);
    --accent:#fff; --accent-ink:var(--ink-on); --chat-bg:rgba(255,255,255,.32); --help-ink:#ffb48a; --cloud:#fff;
    color:var(--ink); color-scheme:dark; }
  :has(> .sky:not(.bare)) { background:#1f2550; }
  :root:not(.morning):not(.evening):not(.night) :is(:has(> .sky:not(.bare)), .on-sky) { text-shadow:0 1px 2px rgba(8,36,96,.18), 0 2px 22px rgba(8,36,96,.3); }
  :is(:has(> .sky:not(.bare)), .on-sky) :is(a.cta, .btn, .plan-btn, button) { text-shadow:none; }

  /* Тёплое (или холодное ночью) свечение у горизонта */
  .horizon { position:absolute; left:-10%; right:-10%; bottom:-30%; height:70%;
    background:radial-gradient(60% 55% at calc(var(--orb-x) * .6 + 20%) 100%, var(--hz), transparent 70%); }

  /* Звёзды: мелкие слоями, яркие поштучно мерцают */
  .stars { position:absolute; inset:0; opacity:var(--star-op); transition:opacity 2s ease; }
  .sf { position:absolute; left:50%; top:0; width:1px; height:1px; margin-left:-1200px; border-radius:50%; }
  .sf.tw { animation:shimmer var(--t) ease-in-out var(--d) infinite alternate; }
  /* Днём звёзд не видно: не тратим кадры на их мерцание */
  :root:not(.evening):not(.night):not(.morning) .stars i { animation:none; }
  .sb { position:absolute; width:var(--s); height:var(--s); border-radius:50%; background:#fff;
    box-shadow:0 0 4px 1px rgba(225,232,255,.55); animation:twinkle var(--t) ease-in-out var(--d) infinite; }
  @keyframes shimmer { from { opacity:.55 } to { opacity:1 } }
  @keyframes twinkle { 0%,100% { opacity:.35; transform:scale(.8) } 50% { opacity:1; transform:scale(1.1) } }

  /* Солнце: яркое ядро, мягкий ореол дышит, вокруг переливается радужное гало, по диагонали блики линзы */
  .orb-wrap { position:absolute; left:var(--orb-x); top:var(--orb-y); width:clamp(46px, 6vw, 72px); aspect-ratio:1;
    opacity:var(--sun-op); transition:opacity 2s ease; }
  .sun, .sun i { position:absolute; border-radius:50%; }
  .sun { inset:0; }
  .sun .core { inset:0; background:radial-gradient(circle, var(--sun-core) 0 38%, color-mix(in srgb, var(--sun-core) 70%, transparent) 52%, transparent 72%);
    filter:blur(.5px); }
  .sun .bloom { inset:-320%; background:radial-gradient(closest-side, var(--sun-bloom), color-mix(in srgb, var(--sun-bloom) 30%, transparent) 30%, transparent 72%);
    animation:bloom 9s ease-in-out infinite; }
  .sun .halo { inset:-150%;
    background:conic-gradient(from 0deg, rgba(255,170,120,.5), rgba(255,240,150,.5), rgba(140,230,200,.5), rgba(130,180,255,.55), rgba(220,150,255,.5), rgba(255,170,120,.5));
    -webkit-mask:radial-gradient(closest-side, transparent 80%, #000 86%, rgba(0,0,0,.5) 91%, transparent 97%); mask:radial-gradient(closest-side, transparent 80%, #000 86%, rgba(0,0,0,.5) 91%, transparent 97%);
    animation:spin 40s linear infinite, ring 7s ease-in-out infinite; }
  .ghost { position:absolute; border-radius:50%; left:50%; top:50%; mix-blend-mode:screen; animation:halo 7s ease-in-out infinite; }
  .g1 { width:60%; height:60%; translate:calc(var(--gx) * 260% - 50%) 240%; background:radial-gradient(circle, rgba(170,220,255,.28), transparent 70%); }
  .g2 { width:130%; height:130%; translate:calc(var(--gx) * 330% - 50%) 330%; background:radial-gradient(circle, transparent 50%, rgba(255,220,170,.16) 66%, transparent 74%); }
  .g3 { width:36%; height:36%; translate:calc(var(--gx) * 760% - 50%) 640%; background:radial-gradient(circle, rgba(200,170,255,.28), transparent 70%); animation-delay:-3s; }
  .morning .ghost, .evening .ghost, .night .ghost { display:none; } /* низкое солнце: блики ушли бы за край */
  @keyframes spin { to { rotate:360deg } }
  @keyframes bloom { 0%,100% { transform:scale(1); opacity:.9 } 50% { transform:scale(1.08); opacity:1 } }
  @keyframes halo { 0%,100% { opacity:.16 } 50% { opacity:.3 } }
  @keyframes ring { 0%,100% { opacity:.07 } 50% { opacity:.15 } }

  /* Перистые облака: бесшовная текстура (тонкие пряди поверх мягких) тянется по диагонали. Один слой: так дешевле для телефона. */
  .wisps { position:absolute; left:-40%; right:-40%; top:-30%; bottom:-30%; rotate:-13deg; opacity:var(--wisp-op); transition:opacity 2s ease; }
  .ws { --m:url(/sky/cirrus.webp); --tile:1900px; --t:260s; position:absolute; top:0; left:0; height:100%; width:calc(var(--tile) * 3); background:var(--wisp);
    -webkit-mask:var(--m) 0 0 / var(--tile) 100% repeat-x; mask:var(--m) 0 0 / var(--tile) 100% repeat-x;
    animation:drift var(--t) linear infinite; will-change:transform; transition:background-color 2s ease; }
  @keyframes drift { to { transform:translateX(calc(var(--tile) * -1)) } }

  /* Кучевые облака плывут слева направо поверху. Двигается только слой, маска не перерисовывается. */
  .cl { position:absolute; left:0; width:var(--w); aspect-ratio:58 / 37; opacity:var(--puff-op);
    animation:sail var(--t) linear var(--d) infinite; will-change:transform; transition:opacity 2s ease; }
  .cl-in { position:absolute; inset:0; }
  .cl i { position:absolute; inset:0; -webkit-mask-size:100% 100%; mask-size:100% 100%; -webkit-mask-repeat:no-repeat; mask-repeat:no-repeat; transition:background-color 2s ease; }
  .c-base { background:var(--cl-lit); -webkit-mask-image:var(--m1); mask-image:var(--m1); }
  .c-shade { background:var(--cl-shade); -webkit-mask-image:var(--m2); mask-image:var(--m2); opacity:.45; }
  .c-lite { background:#fff; -webkit-mask-image:var(--m3); mask-image:var(--m3); opacity:.8; }
  .cl.far { opacity:calc(var(--puff-op) * .6); }
  .cl.near { opacity:calc(var(--puff-op) * .8); }
  .cl.far .cl-in { transform:scale(.6); filter:blur(1px); }
  .cl.mid .cl-in { transform:scale(.8); }
  @keyframes sail { from { transform:translateX(-50vw) } to { transform:translateX(115vw) } }

  @supports (animation-timeline: view()) {
    .orb-wrap { animation:par-orb linear both; animation-timeline:view(); }
    .cl.near .cl-in { animation:par-near linear both; animation-timeline:view(); }
    @keyframes par-orb { from { translate:0 30px } to { translate:0 -30px } }
    @keyframes par-near { from { translate:0 -24px } to { translate:0 24px } }
  }

  @media (max-width: 640px) {
    .orb-wrap { width:40px; }
    .cl .cl-in { transform:scale(.55); } .cl.mid .cl-in { transform:scale(.46); } .cl.far .cl-in { transform:scale(.38); }
    .ws { --tile:1300px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .sf, .sb, .sun i, .ghost, .orb-wrap, .cl-in, .ws { animation:none !important; }
    .cl { animation-play-state:paused; }
  }
</style>
