# Скопируй в .env и заполни. Файл .env в git не попадает.

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# Мозг Inlo: stub (заглушка, без сети) | gigachat | openai (любой OpenAI-совместимый API)
LLM_PROVIDER=stub
# Модель меняется одной строкой. Для GigaChat: GigaChat-2 (Lite), GigaChat-2-Pro, GigaChat-2-Max
LLM_MODEL=GigaChat-2
LLM_TEMPERATURE=0.6
LLM_MAX_TOKENS=600

# GigaChat: «Ключ авторизации» из личного кабинета developers.sber.ru (уже в base64)
GIGACHAT_AUTH_KEY=
# GIGACHAT_API_PERS для физлиц (Freemium), GIGACHAT_API_B2B / GIGACHAT_API_CORP для юрлиц
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Сертификаты GigaChat выпущены НУЦ Минцифры, Node им сам не доверяет. См. README.
# NODE_EXTRA_CA_CERTS=./certs/russian_trusted_root_ca.pem

# Только для LLM_PROVIDER=openai (YandexGPT, Qwen через совместимый шлюз и т.п.)
OPENAI_BASE_URL=
OPENAI_API_KEY=

# Соль для хэша Telegram ID (любая длинная случайная строка). Сырые ID не храним.
ID_SALT=

# Ссылка на страницу /chat для кнопки Mini App (пусто = кнопки нет)
WEBAPP_URL=https://www.heyinlo.com/chat

# HTTP API для веб-чата /chat и Mini App
PORT=8080
# Секрет подписи токенов сессий (длинная случайная строка, не равная ID_SALT)
SESSION_SECRET=
# С каких сайтов браузер может звать API, через запятую
ALLOWED_ORIGINS=https://www.heyinlo.com,https://mira-plum-mu.vercel.app

# База (SQLite-файл на сервере в РФ): согласие, тарифы, коды тестеров, история премиума
DB_PATH=./data/mira.db
# Публичный адрес API для полных ссылок на голосовые ответы, например https://api.heyinlo.com
PUBLIC_API_URL=
# Секрет для webhook Telegram (A-Z a-z 0-9 _ -). Задан вместе с PUBLIC_API_URL = webhook, пусто = long polling
TELEGRAM_WEBHOOK_SECRET=

# Тарифы
FREE_VOICE_TRIAL=5
FREE_TEXT_PER_DAY=15
# Голос Inlo: none (пока нет своего синтеза)
TTS_PROVIDER=none
