---
import Base from '../layouts/Base.astro';
import MiniCloud from '../components/MiniCloud.astro';

// Один экран, два входа: сайт (/chat) и Telegram Mini App (бот открывает эту же страницу).
// Без PUBLIC_MIRA_API страница работает как демо на /api/chat (Gemini), с ним ходит в API бота на сервере в РФ.
const demo = !import.meta.env.PUBLIC_MIRA_API;
---
<Base app title="Поговорить с Mira" description="Напиши, что тревожит: Mira выслушает, поможет разобрать мысль и подышит вместе с тобой. AI-поддержка, не заменяет психолога, 18+.">
  <script is:inline>
    // SDK Telegram грузим только внутри Telegram: обычный посетитель сайта ничего не отправляет на telegram.org
    if (/tgWebApp/.test(location.hash + location.search)) {
      document.documentElement.classList.add('tg');
      document.write('<script src="https://telegram.org/js/telegram-web-app.js?59"><\/script>');
    }
  </script>

  <div class="chat" data-demo={demo ? '' : undefined}>
    <header class="bar">
      <a class="back" href="/" aria-label="На главную">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
      <div class="who">
        <span class="ava"><MiniCloud size={30} /></span>
        <span class="name"><b>Mira</b><small class="status">AI, не психолог</small></span>
      </div>
      <a class="sos" href="/help">Помощь</a>
      <button class="more" type="button" aria-label="Ещё" aria-expanded="false" aria-controls="menu">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="5" cy="12" r="1.8"/><circle cx="12" cy="12" r="1.8"/><circle cx="19" cy="12" r="1.8"/></svg>
      </button>
      <div class="menu" id="menu" role="menu" hidden>
        <button type="button" role="menuitem" data-act="breathe">Подышать минуту</button>
        <button type="button" role="menuitem" data-act="reset">Начать заново</button>
        <a role="menuitem" href="/privacy">Конфиденциальность</a>
      </div>
    </header>

    <section class="gate" aria-labelledby="gate-h">
      <div class="g-cloud" aria-hidden="true"><MiniCloud size={92} /></div>
      <h1 id="gate-h">Привет, я&nbsp;Mira.</h1>
      <p class="g-lead">Выслушаю, помогу разобрать тревожную мысль и&nbsp;подышу вместе с&nbsp;тобой.</p>
      <ul class="facts">
        <li><span class="ic" aria-hidden="true">AI</span><span><b>Я AI, а&nbsp;не&nbsp;психолог.</b> Не&nbsp;ставлю диагнозов и&nbsp;не&nbsp;заменяю специалиста.</span></li>
        <li><span class="ic sos-ic" aria-hidden="true">+</span><span><b>Если очень плохо,</b> звони 112 или на&nbsp;линию МЧС. Номера всегда под кнопкой «Помощь» сверху.</span></li>
        {demo
          ? <li><span class="ic" aria-hidden="true">i</span><span><b>Это демо.</b> Пока отвечает Google Gemini, переписку мы не&nbsp;храним. Своя Mira заработает к&nbsp;запуску.</span></li>
          : <li><span class="ic" aria-hidden="true">i</span><span><b>Без регистрации.</b> Не&nbsp;спрашиваю имя и&nbsp;телефон.</span></li>}
      </ul>
      <label class="check"><input type="checkbox" id="c18" /><span class="box" aria-hidden="true"></span><span>Мне есть 18&nbsp;лет</span></label>
      <label class="check"><input type="checkbox" id="cdata" /><span class="box" aria-hidden="true"></span><span>Согласен(на) на&nbsp;обработку того, что я&nbsp;пишу о&nbsp;самочувствии. <a href="/privacy">Как это устроено</a></span></label>
      <button class="start" type="button" disabled>Начать</button>
    </section>

    <section class="log" aria-live="polite" aria-label="Переписка с Mira"></section>

    <div class="chips" role="group" aria-label="Быстрый ответ">
      <button type="button" data-say="Мне тревожно">Мне тревожно</button>
      <button type="button" data-say="Не могу уснуть">Не могу уснуть</button>
      <button type="button" data-say="Хочу просто выговориться">Хочу выговориться</button>
      <button type="button" data-act="breathe">Подышать минуту</button>
    </div>

    <form class="composer" autocomplete="off">
      <label class="sr" for="q">Сообщение для Mira</label>
      <textarea id="q" rows="1" maxlength="1000" placeholder="Сообщение" enterkeyhint="send"></textarea>
      <button class="send" type="submit" aria-label="Отправить" disabled>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19V6m0 0l-6 6m6-6l6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </form>

    <dialog class="sheet" aria-labelledby="br-h">
      <p class="br-step" id="br-h" aria-live="polite">Приготовься</p>
      <div class="br-cloud" aria-hidden="true"><MiniCloud size={150} sleepy /></div>
      <p class="br-count" aria-hidden="true"></p>
      <div class="br-progress" aria-hidden="true"><i></i></div>
      <button class="br-close" type="button">Хватит</button>
    </dialog>
  </div>
</Base>

<script>
  import { CRISIS_RE } from '../lib/crisis';

  type Msg = { who: 'me' | 'mira'; text: string; crisis?: boolean };
  const API = (import.meta.env.PUBLIC_MIRA_API || '').replace(/\/$/, '');
  const root = document.querySelector<HTMLElement>('.chat')!;
  const log = root.querySelector<HTMLElement>('.log')!;
  const form = root.querySelector<HTMLFormElement>('.composer')!;
  const input = form.querySelector('textarea')!;
  const send = form.querySelector<HTMLButtonElement>('.send')!;
  const chips = root.querySelector<HTMLElement>('.chips')!;
  const status = root.querySelector<HTMLElement>('.status')!;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const tg = (window as any).Telegram?.WebApp;
  const KEY = 'mira-chat', CONSENT = 'mira-consent-v1';

  const store = {
    get: (k: string, s: Storage) => { try { return s.getItem(k); } catch { return null; } },
    set: (k: string, v: string, s: Storage) => { try { s.setItem(k, v); } catch {} },
    del: (k: string, s: Storage) => { try { s.removeItem(k); } catch {} },
  };

  // ── Telegram: тема, высота, хаптика ──────────────────────────────
  const haptic = (kind: 'send' | 'warn') => {
    try { kind === 'send' ? tg?.HapticFeedback?.impactOccurred('light') : tg?.HapticFeedback?.notificationOccurred('warning'); } catch {}
  };
  if (tg) {
    tg.ready();
    tg.expand();
    tg.disableVerticalSwipes?.();
    const applyTheme = () => {
      const p = tg.themeParams || {}, s = document.documentElement.style;
      const map: Record<string, string | undefined> = {
        '--bg': p.bg_color, '--chat-bg': p.bg_color, '--ink': p.text_color, '--muted': p.hint_color,
        '--accent': p.button_color, '--accent-ink': p.button_text_color, '--bubble': p.secondary_bg_color, '--surface': p.secondary_bg_color,
      };
      for (const [k, v] of Object.entries(map)) if (v) s.setProperty(k, v);
      document.documentElement.classList.toggle('tg-dark', tg.colorScheme === 'dark');
      try { tg.setHeaderColor?.('bg_color'); tg.setBackgroundColor?.('bg_color'); } catch {}
    };
    applyTheme();
    tg.onEvent?.('themeChanged', applyTheme);
  }

  // ── Сообщения ────────────────────────────────────────────────────
  let msgs: Msg[] = JSON.parse(store.get(KEY, sessionStorage) || '[]');
  const save = () => store.set(KEY, JSON.stringify(msgs.slice(-60)), sessionStorage);

  // Номера и ссылки в ответах делаем нажимаемыми; HTML из ответа модели не вставляем никогда
  function richText(el: HTMLElement, text: string) {
    const re = /(https?:\/\/[^\s)]+|\+7\s?495\s?989[-‑\s]?50[-‑\s]?50|\b112\b)/g;
    let last = 0;
    for (const m of text.matchAll(re)) {
      el.append(text.slice(last, m.index));
      const a = document.createElement('a');
      const v = m[0];
      a.href = v.startsWith('http') ? v : v === '112' ? 'tel:112' : 'tel:+74959895050';
      a.textContent = v.replace(/^https?:\/\/mira-plum-mu\.vercel\.app/, '') || v;
      el.append(a);
      last = (m.index || 0) + v.length;
    }
    el.append(text.slice(last));
  }

  function crisisCard() {
    const card = document.createElement('div');
    card.className = 'sos-card';
    card.innerHTML = `
      <a class="call urgent" href="tel:112"><span><small>Экстренные службы</small><b>112</b></span><i aria-hidden="true"></i></a>
      <a class="call" href="tel:+74959895050"><span><small>Психологи МЧС, круглосуточно</small><b>+7 495 989‑50‑50</b></span><i aria-hidden="true"></i></a>
      <a class="all" href="/help">Все проверенные номера ›</a>`;
    return card;
  }

  const HELP_LINE = /^(112 —|\+7 495 989-50-50 —|Все проверенные номера:).*$/gm;
  function bubble(m: Msg, animate = true) {
    const row = document.createElement('div');
    row.className = `row ${m.who}`;
    const prev = log.lastElementChild;
    if (prev?.classList.contains(m.who)) prev.classList.add('cont');
    const b = document.createElement('div');
    b.className = 'b';
    // В кризисном ответе номера показываем карточкой с кнопками, а не строками текста
    const text = m.crisis ? m.text.replace(HELP_LINE, '').replace(/\n{3,}/g, '\n\n').trim() : m.text;
    richText(b, text);
    row.append(b);
    if (m.crisis) row.append(crisisCard());
    if (animate && !reduce) row.classList.add('pop');
    log.append(row);
    scrollDown();
    return row;
  }

  function scrollDown() { requestAnimationFrame(() => log.scrollTo({ top: log.scrollHeight, behavior: reduce ? 'auto' : 'smooth' })); }

  function push(m: Msg) { msgs.push(m); save(); bubble(m); if (m.who === 'mira' && m.crisis) haptic('warn'); }

  function typing() {
    const row = document.createElement('div');
    row.className = 'row mira typing pop';
    row.innerHTML = '<div class="b" aria-label="Mira печатает"><i></i><i></i><i></i></div>';
    log.append(row);
    status.textContent = 'печатает…';
    root.classList.add('thinking');
    scrollDown();
    return () => { row.remove(); status.textContent = 'AI, не психолог'; root.classList.remove('thinking'); };
  }

  // ── Транспорт: API бота или демо ─────────────────────────────────
  function deviceToken() {
    let t = store.get('mira-device', localStorage);
    if (!t) { t = crypto.randomUUID(); store.set('mira-device', t, localStorage); }
    return t;
  }
  const auth = () => (tg?.initData ? `tma ${tg.initData}` : `web ${deviceToken()}`);

  async function callApi(path: string, body: object) {
    return fetch(`${API}${path}`, {
      method: 'POST',
      headers: { 'content-type': 'application/json', authorization: auth() },
      body: JSON.stringify(body),
      signal: AbortSignal.timeout(30000),
    });
  }

  const SOON = 'Я пока учусь отвечать: полноценный разговор откроется к запуску. Можем прямо сейчас подышать вместе, кнопка «Подышать минуту» ниже. А если тяжело, нажми «Помощь» сверху.';
  const SLOW = 'Давай чуть притормозим, я не успеваю. Напиши мне через пару минут.';
  const FAIL = 'Извини, я сейчас не могу ответить: что-то сломалось у меня внутри. Попробуй через минуту.';
  const CRISIS_TEXT = 'Мне очень жаль, что тебе так тяжело. То, что ты чувствуешь, слишком серьёзно, чтобы оставаться с этим наедине или только с AI. Пожалуйста, позвони прямо сейчас, это бесплатно и круглосуточно. Я здесь, пока ты набираешь номер.';

  async function ask(text: string): Promise<Msg> {
    if (API) {
      let res = await callApi('/webapp/message', { text });
      if (res.status === 429) return { who: 'mira', text: SLOW };
      if (!res.ok) return { who: 'mira', text: FAIL };
      let data = await res.json();
      if (data.needConsent) { await callApi('/webapp/consent', {}); res = await callApi('/webapp/message', { text }); data = await res.json(); }
      return { who: 'mira', text: data.text || FAIL, crisis: !!data.crisis };
    }
    if (CRISIS_RE.test(text)) return { who: 'mira', text: CRISIS_TEXT, crisis: true };
    const history = msgs.filter((m) => !m.crisis).slice(-20).map((m) => ({ role: m.who === 'me' ? 'user' : 'model', text: m.text }));
    while (history[0]?.role === 'model') history.shift();
    const res = await fetch('/api/chat', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ messages: history }) });
    if (res.status === 503 || res.status === 404) return { who: 'mira', text: SOON };
    if (res.status === 429) return { who: 'mira', text: SLOW };
    if (!res.ok) return { who: 'mira', text: FAIL };
    const data = await res.json();
    return { who: 'mira', text: (data.text || FAIL).replace(/\*\*?|__|^#+\s*/gm, '') };
  }

  let busy = false;
  async function say(text: string) {
    text = text.trim();
    if (!text || busy) return;
    busy = true;
    haptic('send');
    root.classList.add('talking');
    push({ who: 'me', text });
    input.value = ''; grow(); sync();
    const done = typing();
    const t0 = performance.now();
    let reply: Msg;
    try { reply = await ask(text); } catch { reply = { who: 'mira', text: FAIL }; }
    // Мгновенный ответ выглядит как робот: даём «подумать» хотя бы полсекунды
    const wait = 650 - (performance.now() - t0);
    if (wait > 0 && !reduce) await new Promise((r) => setTimeout(r, wait));
    done();
    push(reply);
    busy = false;
    sync();
  }

  // ── Поле ввода ───────────────────────────────────────────────────
  function grow() { input.style.height = 'auto'; input.style.height = `${Math.min(input.scrollHeight, 140)}px`; }
  function sync() { send.disabled = busy || !input.value.trim(); root.classList.toggle('has-text', !!input.value.trim()); }
  input.addEventListener('input', () => { grow(); sync(); });
  input.addEventListener('keydown', (e) => {
    // Enter отправляет на компьютере, на телефоне Enter это перенос строки
    if (e.key === 'Enter' && !e.shiftKey && !e.isComposing && matchMedia('(pointer: fine)').matches) { e.preventDefault(); form.requestSubmit(); }
  });
  form.addEventListener('submit', (e) => { e.preventDefault(); say(input.value); });
  chips.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button');
    if (!b) return;
    if (b.dataset.act === 'breathe') breathe(); else say(b.dataset.say || '');
  });

  // ── Приветствие и ворота ─────────────────────────────────────────
  function greet() {
    const night = document.documentElement.classList.contains('night');
    push({ who: 'mira', text: night
      ? 'Не спится? Я рядом. Расскажи, что крутится в голове, или давай просто подышим.'
      : 'Я рядом. Расскажи, что у тебя сейчас происходит. Можно с любого места, даже одним словом.' });
  }

  function openChat(first: boolean) {
    root.classList.add('ready');
    if (first && !msgs.length) setTimeout(greet, reduce ? 0 : 420);
    else msgs.forEach((m) => bubble(m, false));
    if (matchMedia('(pointer: fine)').matches) setTimeout(() => input.focus(), 500);
  }

  const c18 = root.querySelector<HTMLInputElement>('#c18')!;
  const cdata = root.querySelector<HTMLInputElement>('#cdata')!;
  const start = root.querySelector<HTMLButtonElement>('.start')!;
  const gateSync = () => { start.disabled = !(c18.checked && cdata.checked); };
  c18.addEventListener('change', gateSync); cdata.addEventListener('change', gateSync);
  start.addEventListener('click', async () => {
    store.set(CONSENT, '1', localStorage);
    haptic('send');
    if (API) callApi('/webapp/consent', {}).catch(() => {});
    openChat(true);
  });
  if (store.get(CONSENT, localStorage)) openChat(true);

  // ── Меню ─────────────────────────────────────────────────────────
  const more = root.querySelector<HTMLButtonElement>('.more')!;
  const menu = root.querySelector<HTMLElement>('.menu')!;
  const toggleMenu = (open = menu.hidden) => { menu.hidden = !open; more.setAttribute('aria-expanded', String(open)); };
  more.addEventListener('click', (e) => { e.stopPropagation(); toggleMenu(); });
  document.addEventListener('click', (e) => { if (!menu.hidden && !menu.contains(e.target as Node)) toggleMenu(false); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) { toggleMenu(false); more.focus(); } });
  menu.addEventListener('click', (e) => {
    const act = (e.target as HTMLElement).closest<HTMLElement>('[data-act]')?.dataset.act;
    if (!act) return;
    toggleMenu(false);
    if (act === 'breathe') breathe();
    if (act === 'reset') { msgs = []; save(); store.del(KEY, sessionStorage); log.innerHTML = ''; root.classList.remove('talking'); greet(); }
  });

  // ── Подышать минуту: вдох 4, выдох 6, шесть кругов ───────────────
  const sheet = root.querySelector<HTMLDialogElement>('.sheet')!;
  const step = sheet.querySelector<HTMLElement>('.br-step')!;
  const count = sheet.querySelector<HTMLElement>('.br-count')!;
  const bar = sheet.querySelector<HTMLElement>('.br-progress i')!;
  let timer = 0;
  function breathe() {
    const IN = 4, OUT = 6, ROUNDS = 6, TOTAL = (IN + OUT) * ROUNDS;
    let t = -2; // две секунды «приготовься»
    sheet.showModal();
    sheet.classList.remove('in', 'out');
    step.textContent = 'Приготовься'; count.textContent = '';
    bar.style.transform = 'scaleX(0)';
    const tickFn = () => {
      t++;
      if (t >= TOTAL) return finish(true);
      if (t < 0) return;
      const inCycle = t % (IN + OUT);
      const inhale = inCycle < IN;
      if (inCycle === 0) { sheet.classList.add('in'); sheet.classList.remove('out'); step.textContent = 'Вдох'; }
      if (inCycle === IN) { sheet.classList.add('out'); sheet.classList.remove('in'); step.textContent = 'Выдох'; }
      count.textContent = String(inhale ? IN - inCycle : IN + OUT - inCycle);
      bar.style.transform = `scaleX(${(t + 1) / TOTAL})`;
    };
    timer = window.setInterval(tickFn, 1000);
  }
  function finish(done: boolean) {
    clearInterval(timer);
    sheet.close();
    if (done && root.classList.contains('ready')) push({ who: 'mira', text: 'Ты молодец. Как ты сейчас, хоть немного спокойнее? Можем поговорить о том, что беспокоит.' });
  }
  sheet.querySelector('.br-close')!.addEventListener('click', () => finish(false));
  sheet.addEventListener('cancel', () => clearInterval(timer));
</script>

<style is:global>
  .app, .app body { height:100%; overflow:hidden; overscroll-behavior:none; }
  .app main { height:100%; background:var(--bg); }
  .tg .back { display:none !important; }

  .chat { --pad:max(16px, env(safe-area-inset-left)); position:relative; height:var(--tg-viewport-height, 100dvh); max-width:760px; margin:0 auto;
    display:grid; grid-template-rows:auto 1fr auto auto; background:var(--bg); }
  .chat .sr { position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0 0 0 0); }

  /* Шапка: стекло, как в «Сообщениях» */
  .chat .bar { position:relative; z-index:3; display:flex; align-items:center; gap:10px; padding:calc(10px + env(safe-area-inset-top)) var(--pad) 10px;
    background:color-mix(in srgb, var(--bg) 78%, transparent); backdrop-filter:saturate(180%) blur(20px); -webkit-backdrop-filter:saturate(180%) blur(20px);
    border-bottom:.5px solid var(--line); }
  .chat .back { display:grid; place-items:center; width:32px; height:32px; margin-left:-8px; color:var(--accent); border-radius:50%; }
  .chat .back svg { width:22px; height:22px; }
  .chat .who { flex:1; min-width:0; display:flex; align-items:center; gap:10px; }
  .chat .ava { display:grid; place-items:center; width:38px; height:38px; border-radius:50%; flex:none;
    background:radial-gradient(circle at 35% 30%, color-mix(in srgb, var(--accent) 22%, var(--bg)), color-mix(in srgb, var(--accent) 45%, var(--bg))); }
  .chat .ava svg { --cloud:#fff; transition:transform .6s cubic-bezier(.3,.7,.2,1); }
  .chat.thinking .ava svg { animation:ava-breathe 1.6s ease-in-out infinite; }
  @keyframes ava-breathe { 50% { transform:scale(1.12) translateY(-1px) } }
  .chat .name { display:flex; flex-direction:column; line-height:1.2; min-width:0; }
  .chat .name small { white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .chat .name b { font-size:16px; font-weight:600; }
  .chat .status { font-size:12.5px; color:var(--muted); transition:color .3s; }
  .chat.thinking .status { color:var(--accent); }
  .chat .sos { font-size:14px; font-weight:600; color:var(--help-ink); text-decoration:none; padding:7px 13px; border-radius:999px;
    background:color-mix(in srgb, var(--help-ink) 11%, transparent); transition:transform .2s; }
  .chat .sos:active { transform:scale(.95); }
  .chat .more { display:grid; place-items:center; width:34px; height:34px; border:0; border-radius:50%; background:none; color:var(--ink); cursor:pointer; margin-right:-6px; }
  .chat .more svg { width:20px; fill:currentColor; }
  .chat .menu { position:absolute; right:var(--pad); top:calc(100% - 4px); min-width:220px; padding:6px; border-radius:16px; display:grid;
    background:color-mix(in srgb, var(--chat-bg) 88%, transparent); backdrop-filter:blur(24px); -webkit-backdrop-filter:blur(24px);
    box-shadow:0 0 0 .5px var(--line), 0 18px 50px -12px rgba(0,0,0,.3); transform-origin:top right; animation:menu-in .28s cubic-bezier(.2,.9,.3,1.15); }
  .chat .menu[hidden] { display:none; }
