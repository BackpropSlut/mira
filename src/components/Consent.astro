---
// Согласие на cookie Яндекс.Метрики (152-ФЗ: cookie и IP это персональные данные).
// Пока человек не нажал «Разрешить», счётчик не загружается вообще. Выбор помним в этом браузере.
// Вебвизор выключен: он записывает экран, а на сайте о самочувствии это лишнее.
interface Props { id: string }
const { id } = Astro.props;
---
<div class="consent" role="region" aria-label="Cookie и аналитика" hidden>
  <p>Чтобы понимать, какие страницы полезны, мы хотим считать посещения через Яндекс&nbsp;Метрику. Она использует cookie. <a href="/privacy#analytics">Подробнее</a></p>
  <div class="c-row">
    <button type="button" data-c="no">Отказаться</button>
    <button type="button" data-c="yes">Разрешить</button>
  </div>
</div>

<script is:inline define:vars={{ id }}>
  (function () {
    var KEY = 'inlo-cookies';
    var box = document.querySelector('.consent');
    var get = function () { try { return localStorage.getItem(KEY); } catch (e) { return null; } };
    function load() {
      (function (m, e, t, r, i, k, a) {
        m[i] = m[i] || function () { (m[i].a = m[i].a || []).push(arguments); };
        m[i].l = 1 * new Date();
        k = e.createElement(t); a = e.getElementsByTagName(t)[0]; k.async = 1; k.src = r; a.parentNode.insertBefore(k, a);
      })(window, document, 'script', 'https://mc.yandex.ru/metrika/tag.js', 'ym');
      window.ym(Number(id), 'init', { clickmap: true, trackLinks: true, accurateTrackBounce: true, webvisor: false });
    }
    var choice = get();
    if (choice === 'yes') return load();
    if (choice === 'no' || !box) return;
    box.hidden = false;
    box.addEventListener('click', function (e) {
      var c = e.target.closest && e.target.closest('[data-c]');
      if (!c) return;
      try { localStorage.setItem(KEY, c.dataset.c); } catch (err) {}
      box.hidden = true;
      if (c.dataset.c === 'yes') load();
    });
  })();
</script>

<style>
  /* Плашка снизу поверх страницы: не сдвигает содержимое, значит, не портит CLS */
  .consent { position:fixed; z-index:20; left:12px; right:12px; bottom:calc(12px + env(safe-area-inset-bottom)); max-width:560px; margin:0 auto;
    display:grid; gap:12px; padding:16px 18px; border-radius:20px; font-size:14.5px; line-height:1.45; color:var(--ink);
    background:color-mix(in srgb, var(--bg) 88%, transparent); backdrop-filter:blur(20px) saturate(160%); -webkit-backdrop-filter:blur(20px) saturate(160%);
    box-shadow:0 0 0 1px var(--line), 0 18px 50px -20px rgba(0,0,0,.35); }
  .consent[hidden] { display:none; }
  .consent a { color:var(--accent); }
  .c-row { display:flex; gap:8px; justify-content:flex-end; }
  .c-row button { font:inherit; font-weight:600; padding:9px 18px; border:0; border-radius:999px; cursor:pointer; color:var(--ink); background:var(--surface); }
  .c-row [data-c=yes] { color:var(--accent-ink); background:var(--accent); }
</style>
