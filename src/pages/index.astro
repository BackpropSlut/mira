---
import { BRAND } from '../lib/brand';
import Base from '../layouts/Base.astro';
import Phone from '../components/Phone.astro';
import VoicePreview from '../components/VoicePreview.astro';

// Заголовок проявляется по словам, как на apple.com. Неразрывные пары держим вместе.
const headline = ['Когда', 'в\u00a0голове', 'шумно,', `${BRAND}`, 'рядом.'];
// Частые вопросы. Ответы сверены с политикой конфиденциальности и планом тарифов, не обещаем лишнего.
// Пока API бота нет, чат на сайте работает как демо через DeepSeek (api/chat.js); коды Plus активировать негде.
// Ответы про данные и сроки зависят от этого: в демо текст уходит в DeepSeek, а не на сервер в России
const chatLive = !!import.meta.env.PUBLIC_MIRA_API;
// Формулировки вопросов совпадают с тем, что люди ищут в Яндексе, ответы честные: Inlo не психолог и не лечит.
const faq = [
  [`${BRAND} это ИИ-психолог?`, `Нет, и ${BRAND} сама так скажет. Это ИИ-помощник психологической поддержки: выслушает, поможет разобрать тревожную мысль по шагам когнитивно-поведенческой терапии и подышит вместе с тобой. Диагнозов не ставит и лечение не назначает. Если нужен специалист, подскажет, к кому обратиться.`],
  ['Где бесплатно поговорить с психологом онлайн?', `С живым психологом бесплатно, анонимно и круглосуточно можно поговорить по телефону: линия психологической помощи МЧС России +7 495 989-50-50. Если хочется сначала просто выговориться или разобрать мысль в чате, напиши ${BRAND}: это тоже бесплатно, но отвечает ИИ, а не психолог.`, '/help', 'Номера помощи'],
  ['Что делать при панической атаке?', 'Напомни себе, что это паника и она пройдёт: обычно приступ доходит до пика за несколько минут, а потом идёт на спад. Дыши медленно, с выдохом длиннее вдоха: вдох на 4 счёта, выдох на 6. Найди глазами пять предметов вокруг. Если болит в груди, приступ впервые или ты не уверен(а), что это паника, звони 112.', '/breathe#panic', 'Подробнее и упражнение'],
  ['Кто увидит, что я пишу?', chatLive
    ? `Имя, телефон и почту ${BRAND} не спрашивает. Переписка хранится на сервере в России не дольше 30 дней, удалить её можно в чате одной кнопкой. Чтобы получить ответ, текст сообщения передаётся российскому провайдеру языковой модели.`
    : `Имя, телефон и почту ${BRAND} не спрашивает. Сейчас чат работает в демо-режиме: чтобы получить ответ, текст уходит в DeepSeek, мы его не сохраняем. Поэтому не пиши имён и личных данных. После запуска переписка будет храниться на сервере в России.`, '/privacy', 'Политика конфиденциальности'],
  ['Сколько это стоит?', `Основное бесплатно: разговор текстом, дыхание и контакты помощи. Позже появится ${BRAND} Plus: голос без ограничений и сохранённая история разговоров. Контакты помощи в трудную минуту всегда бесплатны.`],
  ['Что делать, если совсем плохо?', `Не жди ответа от AI. Звони 112 или на линию психологической помощи МЧС: +7 495 989-50-50, круглосуточно и бесплатно. Если в разговоре прозвучит что-то тревожное, ${BRAND} сама покажет эти номера.`, '/help', 'Все номера помощи'],
  chatLive
    ? ['Где поговорить с Inlo?', 'Прямо на этом сайте и в Telegram. Подышать вместе с облачком можно на вкладке «Подышать».', '/chat', 'Открыть чат']
    : ['Когда можно будет поговорить?', 'Уже сейчас, прямо на сайте: это демо, ответы пишет DeepSeek. Полный запуск с собственным сервером и Telegram-ботом в ноябре 2026 года.', '/chat', 'Открыть чат'],
];
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
};
const limits = [
  ['Это AI', `${BRAND} работает на искусственном интеллекте. Если спросишь, с\u00a0кем ты говоришь, она так и ответит.`],
  ['Без диагнозов', 'Поддерживает и помогает разобраться, а диагнозы и лекарства оставляет врачам.'],
  ['Подскажет, кто поможет', `Если станет совсем тяжело, ${BRAND} сразу даст контакты людей, которые рядом круглосуточно.`],
  ['Для взрослых', 'Сервис рассчитан на тех, кому уже есть 18.'],
];
---
<Base title={`${BRAND}: чат поддержки при тревоге с ИИ-помощником`} description={`${BRAND} выслушает, поможет разобрать тревожную мысль по шагам КПТ и подышит с тобой. ИИ-поддержка в Telegram и на сайте, бесплатно, 18+. Не заменяет психолога.`}>
  {/* Облачко для логотипа в заголовке и плашки «пара»: одна форма, рисуем через <use> */}
  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <symbol id="cloud-shape" viewBox="34 26 236 192"><g fill="currentColor"><rect x="40" y="118" width="220" height="96" rx="48"/><circle cx="100" cy="128" r="52"/><circle cx="160" cy="96" r="66"/><circle cx="220" cy="130" r="46"/></g></symbol>
  </svg>

  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="status">{chatLive ? <><i aria-hidden="true"></i>AI-поддержка · 18+</> : <><i aria-hidden="true"></i>AI-поддержка · запуск в&nbsp;ноябре</>}</p>
        <h1 aria-label={headline.join(' ')}>{headline.map((w, i) => <>{i > 0 && ' '}<span class="w" aria-hidden="true" style={`--w:${i}`}>{w === BRAND && BRAND.endsWith('o')
          ? <em>{BRAND.slice(0, -1)}<svg class="glyph"><use href="#cloud-shape"/></svg></em>
          : w}</span></>)}</h1>
        <p class="sub">Выслушает, поможет разобрать тревожную мысль и&nbsp;подышит вместе с&nbsp;тобой. Текстом или голосом, в&nbsp;любое время.</p>
        {/* Чат работает уже сейчас (демо до запуска), поэтому главная кнопка ведёт в разговор, дыхание рядом */}
        <p class="meta"><a class="cta" href="/chat">Поговорить с&nbsp;{BRAND}</a><a class="link" href="/breathe">Подышать минуту&nbsp;›</a></p>
      </div>
      {/* Телефон с живым демо-чатом, за ним выезжает розовый язычок, как у визиток sofa */}
      <div class="hero-phone theme">
        <div class="phone-stage">
          <Phone />
          <a class="tab" href="/chat" tabindex="-1" aria-hidden="true">Напиши мне</a>
        </div>
      </div>
    </div>
  </section>

  <section id="talk" class="block reveal">
    <div class="wrap split">
      <div>
        <h2>Можно просто выговориться.</h2>
        <p class="lead">{BRAND} не перебивает и не оценивает. А если захочешь, поможет спокойно разложить тревожную мысль по шагам, как это делают в когнитивно-поведенческой терапии.</p>
      </div>
      {/* Шаги КПТ плашками: прямое начало с номером, круглый конец */}
      <ol class="cbt">
        <li><div><span>Что случилось</span><em>«Завтра разговор с начальником»</em></div></li>
        <li><div><span>Что ты подумал</span><em>«Меня точно уволят»</em></div></li>
        <li><div><span>Что есть на самом деле</span><em>«Он хотел обсудить проект»</em></div></li>
        <li><div><span>Как на это можно посмотреть</span><em>«Это разговор, а не приговор»</em></div></li>
      </ol>
    </div>
  </section>

  <section class="block reveal">
    <div class="wrap narrow">
      <h2>Ответы можно слушать.</h2>
      <p class="lead">Голоса записываем с&nbsp;живыми людьми специально для {BRAND}: мужской и&nbsp;женский, на&nbsp;выбор.</p>
      <VoicePreview />
    </div>
  </section>

  <section class="block reveal">
    <div class="wrap">
      <h2 class="limits-h">Что {BRAND} умеет и&nbsp;что оставляет специалистам.</h2>
      <p class="lead">{BRAND} рядом, когда нужно выговориться или успокоиться. А&nbsp;в&nbsp;том, что требует специалиста, она подскажет, к&nbsp;кому обратиться.</p>
      <dl class="limits">
        {limits.map(([t, d], i) => (<div class:list={{ wide: i === 2 }}><dt>{t}</dt><dd>{d}</dd></div>))}
        <div class="pair" aria-hidden="true">
          <span>i<svg><use href="#cloud-shape"/></svg></span>
          <span>i<svg viewBox="0 0 100 100"><path d="M14 18h72a10 10 0 0 1 10 10v36a10 10 0 0 1-10 10H44l-20 16V74H14A10 10 0 0 1 4 64V28a10 10 0 0 1 10-10z" fill="currentColor"/></svg></span>
        </div>
      </dl>
    </div>
  </section>

  <section id="plans" class="block reveal">
    <div class="wrap">
      <div class="narrow-head">
        <p class="eyebrow">Тарифы</p>
        <h2>Разговор и&nbsp;дыхание бесплатно.</h2>
        <p class="lead">Поговорить, подышать и&nbsp;найти помощь можно без оплаты. {BRAND}&nbsp;Plus для тех, кто хочет слушать {BRAND} и&nbsp;возвращаться к&nbsp;своим разговорам.</p>
      </div>
      <div class="plans">
        <article class="plan free">
          <h3>Бесплатно</h3>
          <p class="price">0&nbsp;₽</p>
          <ul>
            <li>Разговор с&nbsp;{BRAND} текстом</li>
            <li>Несколько голосовых ответов на&nbsp;пробу</li>
            <li>Дыхательные упражнения</li>
            <li>Номера помощи 24/7, всегда без лимитов</li>
          </ul>
          <a class="plan-btn" href="/chat">Поговорить с&nbsp;{BRAND}</a>
        </article>
        <article class="plan plus">
          <h3>{BRAND}&nbsp;Plus</h3>
          <p class="price">Цена появится к&nbsp;запуску</p>
          <ul>
            <li>{BRAND} отвечает голосом, без ограничений</li>
            <li>История разговоров сохраняется</li>
            <li>Всё, что есть в&nbsp;бесплатной версии</li>
          </ul>
          {chatLive
            ? <><a class="plan-btn hi" href="/chat#plus">У&nbsp;меня есть код</a><p class="plan-note">Тестировщикам код выдаёт команда {BRAND}.</p></>
            : <p class="plan-note">Коды для тестировщиков заработают вместе с&nbsp;чатом, к&nbsp;запуску.</p>}
        </article>
      </div>
    </div>
  </section>

  <section id="faq" class="block reveal">
    <div class="wrap narrow">
      <h2>Частые вопросы.</h2>
      <div class="faq">
        {faq.map(([q, a, href, label]) => (
          <details>
            <summary><span>{q}</span><i aria-hidden="true"></i></summary>
            <p>{a}{href && <> <a class="link" href={href}>{label}&nbsp;›</a></>}</p>
          </details>
        ))}
      </div>
    </div>
    <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  </section>

  <section class="block reveal">
    <div class="wrap narrow">
      <p class="crisis">Если тяжело прямо сейчас, не&nbsp;жди запуска. <a class="link" href="/help">Куда позвонить&nbsp;›</a></p>
    </div>
  </section>
</Base>

<style>
  /* Кнопки сайта: чёрная пилюля на бумаге, розовая в тёмной теме (через --accent) */
  .cta, .plan-btn { display:inline-flex; align-items:center; min-height:50px; padding:0 26px; border-radius:999px; font-family:var(--display); font-weight:700; font-size:16px; text-decoration:none;
    color:var(--accent-ink); background:var(--accent); transition:transform .45s cubic-bezier(.3,1.5,.4,1); }
  .cta:hover, .plan-btn:hover { transform:scale(1.04); }
  .cta:active, .plan-btn:active { transform:scale(.96); transition-duration:.12s; }

  .hero { padding: clamp(48px, 8vw, 104px) 0 clamp(56px, 8vw, 112px); overflow-x:clip; }
  .hero-grid { display:grid; gap:48px; align-items:center; grid-template-columns: 1.15fr 1fr; }
  .hero-grid > * { min-width:0; }
  .hero h1 { font-size: clamp(42px, 6.6vw, 80px); line-height:1.02; text-wrap:balance; }
  .hero h1 em { font-style:italic; white-space:nowrap; }
  .glyph { display:inline-block; width:.95em; height:.78em; margin-left:.02em; vertical-align:-.02em; color:var(--pink); }
  .sub { margin-top:22px; font-size: clamp(18px, 2vw, 21px); line-height:1.45; color:var(--muted); max-width:32ch; }
  .meta { margin-top:32px; display:flex; flex-wrap:wrap; align-items:center; gap:12px 24px; font-size:17px; }
  /* Плашка статуса: розовая точка и капс Montserrat */
  .status { display:inline-flex; align-items:center; gap:8px; margin-bottom:22px; font-family:var(--display); font-weight:700; font-size:13px; letter-spacing:.08em; text-transform:uppercase; }
  .status i { width:8px; height:8px; border-radius:50%; background:var(--pink); animation:pulse 2.4s ease-in-out infinite; }
  @keyframes pulse { 50% { opacity:.35; transform:scale(.8) } }

  .hero-phone { display:flex; justify-content:center; perspective:1400px; }
  .phone-stage { position:relative; padding-right:140px; }
  .phone-stage :global(.phone-wrap) { position:relative; z-index:1; }
  .tab { position:absolute; z-index:0; right:0; top:58%; display:flex; align-items:center; justify-content:flex-end; width:240px; height:62px; padding-right:18px;
    border-radius:0 999px 999px 0; background:var(--pink); color:var(--on-pink); font-family:var(--display); font-weight:800; font-size:13px; letter-spacing:.04em; text-transform:uppercase; text-decoration:none; white-space:nowrap;
    animation: tab-in .9s cubic-bezier(.3,1.3,.4,1) 1.4s both; transition:transform .5s cubic-bezier(.3,1.4,.4,1); }
  .tab:hover { transform:translateX(8px); }
  @keyframes tab-in { from { transform:translateX(-90px); opacity:0 } }

  /* Вход: слова заголовка всплывают одно за другим, затем текст, кнопка и телефон.
     Стартуем не с нуля прозрачности: заголовок виден с первого кадра, это быстрый LCP */
  .hero h1 .w { display:inline-block; opacity:.2; filter:blur(10px); transform:translateY(.32em);
    animation: word 1.1s cubic-bezier(.2,.75,.2,1) forwards; animation-delay:calc(.08s + var(--w) * .085s); }
  @keyframes word { to { opacity:1; filter:none; transform:none } }
  .hero-copy > :not(h1) { opacity:0; animation: up 1s cubic-bezier(.2,.7,.2,1) forwards; }
  .hero-copy > .status { animation-delay:0s } .hero-copy > .sub { animation-delay:.5s } .hero-copy > .meta { animation-delay:.62s }
  @keyframes up { from { opacity:0; transform:translateY(16px) } to { opacity:1; transform:none } }
  .hero-phone :global(.phone) { view-transition-name: mira-chat; animation: phone-in 1.5s cubic-bezier(.16,.84,.24,1) .25s both; transform-origin:50% 80%; }
  @keyframes phone-in { from { opacity:0; transform:translateY(90px) rotateX(24deg) scale(.9) } }

  .block { padding: clamp(64px, 10vw, 120px) 0; overflow-x:clip; }
  .narrow { max-width:800px; }
  .center { text-align:center; }
  .center .lead { margin-inline:auto; }
  .eyebrow { font-family:var(--display); font-weight:700; font-size:13px; letter-spacing:.1em; text-transform:uppercase; color:var(--link); margin-bottom:14px; }
  h2 { font-size: clamp(34px, 5vw, 58px); text-wrap:balance; }
  .lead { margin-top:18px; font-size: clamp(18px, 1.9vw, 20px); line-height:1.5; color:var(--muted); max-width:44ch; }

  /* КПТ: слева заголовок, справа плашки шагов */
  .split { display:grid; grid-template-columns:.9fr 1.1fr; gap:48px; align-items:start; }
  .split > * { min-width:0; }
  .cbt { list-style:none; padding:0; display:grid; gap:12px; counter-reset:s; }
  .cbt li { counter-increment:s; display:grid; grid-template-columns:64px 1fr; border-radius:0 999px 999px 0; background:var(--surface); overflow:hidden; }
  .cbt li::before { content:counter(s); display:grid; place-items:center; font-family:var(--display); font-weight:800; font-size:22px; background:var(--card); color:var(--card-ink); }
  .cbt li:nth-child(2)::before { background:var(--pink); color:var(--on-pink); } /* шаг с тревожной мыслью */
  .cbt div { padding:16px 40px 16px 20px; min-width:0; }
  .cbt span { display:block; font-weight:600; }
  .cbt em { font-style:normal; color:var(--muted); }

  /* Границы: бенто из чёрных карточек и одна розовая с «парами» буква + объект */
  .limits { margin-top:44px; display:grid; grid-template-columns:repeat(3, 1fr); grid-auto-flow:dense; gap:14px; }
  .limits > div { min-width:0; padding:26px; border-radius:26px; background:var(--card); color:var(--card-ink); }
  .limits dt { font-family:var(--display); font-weight:800; font-size:22px; letter-spacing:-.03em; }
  .limits dd { margin:8px 0 0; color:var(--card-muted); }
  .limits .wide { grid-column:span 2; }
  .limits .pair { display:flex; align-items:center; justify-content:center; gap:22px; flex-wrap:wrap; background:var(--pink); color:var(--on-pink); }
  .pair span { display:inline-flex; align-items:center; font-family:var(--display); font-weight:800; font-size:54px; letter-spacing:-.05em; line-height:1; }
  .pair svg { width:.95em; height:.95em; color:#f8f1e5; }

  /* Тарифы: бесплатный в обводке, Plus чёрной карточкой с розовой кнопкой */
  .narrow-head { max-width:900px; }
  .plans { margin-top:44px; max-width:900px; display:grid; grid-template-columns:1fr 1fr; gap:20px; align-items:stretch; }
  .plan { position:relative; min-width:0; display:flex; flex-direction:column; gap:10px; padding:30px 28px 28px; border-radius:26px; }
  .plan.free { box-shadow:inset 0 0 0 2px var(--ink); }
  .plan.plus { background:var(--card); color:var(--card-ink); }
  .plan h3 { font-size:26px; }
  .plan .price { font-weight:600; color:var(--muted); }
  .plan.plus .price, .plan.plus .plan-note { color:var(--card-muted); }
  .plan ul { list-style:none; padding:0; margin:8px 0 18px; display:grid; gap:10px; flex:1; align-content:start; }
  .plan li { position:relative; padding-left:26px; line-height:1.4; }
  .plan li::before { content:""; position:absolute; left:0; top:.32em; width:13px; height:13px; border-radius:0 999px 999px 0; background:var(--pink); }
  .plan-btn { align-self:flex-start; }
  .plan-btn.hi { color:var(--on-pink); background:var(--pink); }
  .plan-note { font-size:14px; color:var(--muted); }
  @media (hover: hover) { .plan:hover { transform:translateY(-4px); } .plan { transition:transform .5s cubic-bezier(.2,.8,.2,1); } }

  /* Вопросы: толстая линия сверху, розовые плюсы */
  .faq { margin-top:36px; border-top:2px solid var(--ink); interpolate-size:allow-keywords; }
  .faq details { border-bottom:1px solid var(--line); }
  .faq summary { display:flex; align-items:center; justify-content:space-between; gap:20px; padding:22px 0; cursor:pointer; list-style:none;
    font-family:var(--display); font-size:clamp(18px, 2vw, 21px); font-weight:700; letter-spacing:-.02em; -webkit-tap-highlight-color:transparent; }
  .faq summary::-webkit-details-marker { display:none; }
  .faq summary i { position:relative; flex:none; width:32px; height:32px; border-radius:50%; background:var(--pink); transition:transform .45s cubic-bezier(.3,1.4,.4,1); }
  .faq summary i::before, .faq summary i::after { content:""; position:absolute; left:50%; top:50%; width:12px; height:2.5px; margin:-1.25px 0 0 -6px; border-radius:2px; background:var(--on-pink); }
  .faq summary i::after { transform:rotate(90deg); }
  .faq details[open] summary i { transform:rotate(45deg); }
  .faq details p { padding:0 48px 24px 0; color:var(--muted); font-size:17px; line-height:1.55; }
  .faq details::details-content { height:0; overflow:clip; opacity:0; transition:height .5s cubic-bezier(.2,.8,.2,1), opacity .4s ease, content-visibility .5s allow-discrete; }
  .faq details[open]::details-content { height:auto; opacity:1; }

  .crisis { font-family:var(--display); font-size: clamp(22px, 3vw, 32px); font-weight:800; letter-spacing:-.03em; line-height:1.25; }

  @media (max-width: 1100px) and (min-width: 881px) { .phone-stage { padding-right:0; } .tab { display:none; } }
  @media (max-width: 880px) {
