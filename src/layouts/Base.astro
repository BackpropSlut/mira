---
import '@fontsource-variable/onest/wght.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Спокойная светлая тема без фаз суток (страница помощи). */
  plain?: boolean;
  /** Полноэкранное приложение без шапки и подвала (/chat, он же Telegram Mini App). */
  app?: boolean;
}
const { title, description, plain = false, app = false } = Astro.props;
const path = Astro.url.pathname.replace(/(\/index)?(\.html)?$/, '') || '/';
const canonical = new URL(path, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;
const isHome = canonical === new URL('/', Astro.site).href;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Mira',
  alternateName: 'Mira, AI-поддержка',
  url: new URL('/', Astro.site).href,
  inLanguage: 'ru',
  description: 'AI-ассистент психологической поддержки: выслушает, поможет разобрать тревожную мысль и подышит вместе с тобой. Не заменяет психолога, 18+.',
  publisher: { '@type': 'Organization', name: 'Mira', url: new URL('/', Astro.site).href, logo: new URL('/apple-touch-icon.png', Astro.site).href },
};
---
<!doctype html>
<html lang="ru" class:list={[{ plain, app }]}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content={app ? 'width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content' : 'width=device-width, initial-scale=1'}>
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  <meta name="theme-color" content="#fbfaf8" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#161a21" media="(prefers-color-scheme: dark)">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Mira">
  <meta property="og:locale" content="ru_RU">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Облачко Mira и надпись: когда в голове шумно, Mira рядом">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="sitemap" href="/sitemap.xml">
  {isHome && <script type="application/ld+json" set:html={JSON.stringify(ld)} />}
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <script is:inline>document.documentElement.classList.add('js');</script>
  {!plain && (
    <script is:inline>
      // Ставим фазу до отрисовки, чтобы не было вспышки не того фона.
      (function () {
        var forced = new URLSearchParams(location.search).get('t'); // ?t=morning|day|evening|night для проверки
        function phase() {
          if (/^(morning|day|evening|night)$/.test(forced || '')) return forced;
          var h = new Date().getHours();
          return h >= 6 && h < 11 ? 'morning' : h >= 11 && h < 18 ? 'day' : h >= 18 && h < 22 ? 'evening' : 'night';
        }
        function apply() {
          var root = document.documentElement, p = phase();
          if (!root.classList.contains(p)) { root.classList.remove('morning', 'day', 'evening', 'night'); root.classList.add(p); }
        }
        apply();
        setInterval(apply, 60000);
      })();
    </script>
  )}
</head>
<body>
  {!app && <header class="site-header">
    <div class="wrap">
      <a class="logo" href="/">Mira</a>
      <a class="help-link" href="/help">Нужна помощь</a>
    </div>
  </header>}

  <main>
    <slot />
  </main>

  {!app && <footer class="site-footer">
    <div class="wrap">
      <p>Mira не заменяет психолога и не ставит диагнозов. Сервис для взрослых 18+.</p>
      <nav aria-label="Ссылки в подвале">
        <a href="/breathe">Подышать минуту</a>
        <a href="/help">Нужна помощь сейчас</a>
        <a href="/privacy">Конфиденциальность</a>
        <a href="https://github.com/BackpropSlut/mira">GitHub</a>
      </nav>
      <p>Студенческий проект ГУУ, 2026.</p>
      <a class="credit" href="https://dqa-web.vercel.app/production" target="_blank" rel="noopener">Разработка: <b>DQA</b></a>
    </div>
  </footer>}
  <script>
    // Плавное появление секций при скролле.
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
    }, { rootMargin: '0px 0px -12% 0px' });
    document.querySelectorAll('.reveal').forEach((el) => {
      // Каскад: заголовок, текст и элементы списков проявляются друг за другом
      el.querySelectorAll<HTMLElement>('.wrap > *, .cbt li, .limits > div').forEach((c, i) => {
        c.classList.add('st');
        c.style.setProperty('--i', String(Math.min(i, 10)));
      });
      io.observe(el);
    });
  </script>

</body>
</html>
