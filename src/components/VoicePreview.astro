---
// Превью голосового ответа: выбор голоса, кнопка play, живая волна и субтитры «караоке».
// Звука нет намеренно: собственные голоса Inlo ещё записываются, чужой синтез сюда не ставим.
const voices = {
  f: { label: 'Женский', text: 'Давай немного замедлимся. Вдох… и длинный, спокойный выдох. Я рядом.' },
  m: { label: 'Мужской', text: 'Похоже, день был непростым. Расскажи, что сейчас крутится в голове?' },
};
const BARS = 46;
const shape = (seed: number) =>
  Array.from({ length: BARS }, (_, i) => {
    const v = Math.abs(Math.sin(i * 0.61 + seed) * 0.6 + Math.sin(i * 0.23 + seed * 2) * 0.4);
    return (0.28 + v * 0.72).toFixed(2);
  });
const fBars = shape(0.4);
const mBars = shape(2.1);
---
<div class="vp" data-voice="f">
  <div class="seg" role="radiogroup" aria-label="Голос Inlo">
    <span class="pill" aria-hidden="true"></span>
    {Object.entries(voices).map(([k, v], i) => (
      <button type="button" role="radio" aria-checked={i === 0 ? 'true' : 'false'} data-k={k} data-text={v.text}>{v.label}</button>
    ))}
  </div>

  <div class="player">
    <button class="play" type="button" aria-label="Показать превью ответа">
      <svg class="i-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.4-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5z" fill="currentColor"/></svg>
      <svg class="i-pause" viewBox="0 0 24 24" aria-hidden="true"><rect x="6.5" y="5" width="4" height="14" rx="1.4" fill="currentColor"/><rect x="13.5" y="5" width="4" height="14" rx="1.4" fill="currentColor"/></svg>
    </button>
    <div class="bars" aria-hidden="true" data-f={fBars.join(',')} data-m={mBars.join(',')}>
      {fBars.map((h) => <i style={`--h:${h}`} />)}
    </div>
    <span class="time" aria-hidden="true">0:07</span>
  </div>

  <p class="caption" aria-live="polite">{voices.f.text.split(' ').map((w) => <span>{w} </span>)}</p>
  <p class="note">Это превью. Настоящие голоса ещё записываем, они появятся к&nbsp;запуску.</p>
</div>

<script>
  const root = document.querySelector<HTMLElement>('.vp')!;
  const bars = [...root.querySelectorAll<HTMLElement>('.bars i')];
  const barsBox = root.querySelector<HTMLElement>('.bars')!;
  const caption = root.querySelector<HTMLElement>('.caption')!;
  const time = root.querySelector<HTMLElement>('.time')!;
  const play = root.querySelector<HTMLButtonElement>('.play')!;
  const segBtns = [...root.querySelectorAll<HTMLButtonElement>('.seg button')];
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const DUR = 7000;
  let words: HTMLElement[] = [];
  let marks: number[] = [];
  let start = 0, playing = false, raf = 0, elapsedAtPause = 0;

  function setText(text: string) {
    caption.innerHTML = '';
    const parts = text.split(' ');
    const total = parts.reduce((s, w) => s + w.length + 2, 0);
    let acc = 0;
    marks = parts.map((w) => { const m = acc / total; acc += w.length + 2; return m; });
    words = parts.map((w) => { const s = document.createElement('span'); s.textContent = w + ' '; caption.append(s); return s; });
    if (reduce) words.forEach((w) => w.classList.add('on'));
  }

  function render(p: number, now: number) {
    const n = bars.length;
    bars.forEach((b, i) => {
      const x = i / n;
      b.classList.toggle('done', x < p);
      // Возле «головки» волна живее, как у настоящей речи
      const near = Math.max(0, 1 - Math.abs(x - p) * 6);
      const wobble = playing ? 0.55 + 0.45 * Math.abs(Math.sin(now / 140 + i * 0.9)) : 1;
      b.style.transform = `scaleY(${(playing ? wobble * (0.75 + near * 0.35) : 1).toFixed(3)})`;
    });
    words.forEach((w, i) => w.classList.toggle('on', p >= marks[i]));
    time.textContent = `0:0${Math.ceil((DUR * (1 - p)) / 1000)}`;
  }

  function tick(now: number) {
    const p = Math.min(1, (now - start) / DUR);
    render(p, now);
    if (p < 1 && playing) raf = requestAnimationFrame(tick);
    else if (p >= 1) stop(true);
  }

  function go() {
    if (reduce) return;
    playing = true;
    root.classList.add('playing');
    play.setAttribute('aria-label', 'Пауза');
    start = performance.now() - elapsedAtPause;
    raf = requestAnimationFrame(tick);
  }
  function stop(finished = false) {
    playing = false;
    cancelAnimationFrame(raf);
    root.classList.remove('playing');
    play.setAttribute('aria-label', 'Показать превью ответа');
    elapsedAtPause = finished ? 0 : performance.now() - start;
    if (finished) setTimeout(() => { if (!playing) render(0, 0); }, 1600);
    else render(elapsedAtPause / DUR, 0);
  }

  play.addEventListener('click', () => (playing ? stop() : go()));

  segBtns.forEach((btn) => btn.addEventListener('click', () => {
    if (btn.getAttribute('aria-checked') === 'true') return;
    segBtns.forEach((b) => b.setAttribute('aria-checked', String(b === btn)));
    root.dataset.voice = btn.dataset.k;
    const hs = (barsBox.dataset[btn.dataset.k as 'f' | 'm'] || '').split(',');
    bars.forEach((b, i) => b.style.setProperty('--h', hs[i]));
    stop(true); elapsedAtPause = 0;
    setText(btn.dataset.text || '');
    render(0, 0);
    go();
  }));

  setText(segBtns[0].dataset.text || '');
  // Один раз сами «проигрываем», когда блок появился на экране
  const io = new IntersectionObserver((es) => {
    if (es.some((e) => e.isIntersecting)) { io.disconnect(); setTimeout(go, 600); }
  }, { threshold: 0.6 });
  io.observe(root);
</script>

<style>
  .vp { margin-top:44px; padding:clamp(20px, 4vw, 32px); border-radius:28px; background:var(--chat-bg);
    box-shadow:0 0 0 1px var(--line), 0 30px 60px -36px rgba(29,29,31,.35); display:grid; gap:22px; }

  .seg { position:relative; display:inline-grid; grid-template-columns:1fr 1fr; justify-self:start; padding:3px; border-radius:999px; background:var(--bubble); }
  .seg button { position:relative; z-index:1; font:inherit; font-size:15px; font-weight:500; padding:7px 18px; border:0; background:none; color:var(--muted); cursor:pointer; border-radius:999px; transition:color .3s; }
  .seg button[aria-checked="true"] { color:var(--ink); }
  .pill { position:absolute; top:3px; bottom:3px; left:3px; width:calc(50% - 3px); border-radius:999px; background:var(--chat-bg);
    box-shadow:0 1px 3px rgba(0,0,0,.12), 0 0 0 .5px var(--line); transition:transform .45s cubic-bezier(.3,.7,.2,1); }
  .vp[data-voice="m"] .pill { transform:translateX(100%); }

  .player { display:flex; align-items:center; gap:16px; }
  .play { flex:none; display:grid; place-items:center; width:56px; height:56px; border-radius:50%; border:0; cursor:pointer;
    background:var(--accent); color:var(--accent-ink); box-shadow:0 8px 20px -8px color-mix(in srgb, var(--accent) 70%, transparent);
    transition:transform .2s cubic-bezier(.3,.7,.2,1); }
  .play:hover { transform:scale(1.05); } .play:active { transform:scale(.94); }
  .play svg { width:24px; height:24px; }
  .i-pause, .playing .i-play { display:none; } .playing .i-pause { display:block; }

  .bars { flex:1; height:64px; display:flex; align-items:center; justify-content:space-between; gap:2px; }
  .bars i { flex:0 1 6px; min-width:2px; height:calc(var(--h) * 100%); border-radius:3px; background:var(--muted); opacity:.35;
    transform-origin:center; transition:background-color .25s, opacity .25s, height .5s cubic-bezier(.3,.7,.2,1); }
  .bars i.done { background:var(--accent); opacity:1; }
  .time { flex:none; font-size:14px; color:var(--muted); font-variant-numeric:tabular-nums; min-width:2.5em; text-align:right; }

  .caption { font-size:clamp(19px, 2.4vw, 23px); line-height:1.45; font-weight:500; letter-spacing:-.015em; min-height:2.9em; }
  .caption :global(span) { color:color-mix(in srgb, var(--muted) 55%, transparent); transition:color .35s ease; }
  .caption :global(span.on) { color:var(--ink); }
  .note { font-size:14px; color:var(--muted); }

  @media (max-width:520px) { .bars { height:52px; } .play { width:48px; height:48px; } }
  @media (prefers-reduced-motion: reduce) { .pill, .bars i, .caption :global(span) { transition:none; } }
</style>
