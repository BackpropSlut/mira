---
import Base from '../layouts/Base.astro';
import MiniCloud from '../components/MiniCloud.astro';

// Только номера, проверенные по официальным сайтам. Новый номер добавляем вместе с источником и датой проверки.
const lines = [
  {
    phone: '112',
    tel: '112',
    title: 'Экстренные службы',
    note: 'Если есть угроза жизни: твоей или чьей-то рядом.',
    urgent: true,
  },
  {
    phone: '+7 495 989-50-50',
    tel: '+74959895050',
    title: 'Психологи МЧС России',
    note: 'Круглосуточно, бесплатно и анонимно. Можно просто сказать «мне плохо».',
    source: 'https://psi.mchs.gov.ru/deyatelnost/distancionnaya-pomoshch-naseleniyu',
  },
];
---
<Base plain title="Нужна помощь сейчас: 112 и психологи МЧС · Inlo" description="Если очень тяжело прямо сейчас: 112 и круглосуточная бесплатная линия психологов МЧС России. Номера проверены по официальным сайтам."
  crumb="Нужна помощь" ogImage="/og/help.jpg" ogAlt="Облачко Inlo и надпись: ты не один, помощь рядом, 112 и психологи МЧС">
  <div class="wrap page">
    <header class="intro">
      <MiniCloud size={64} sleepy class="cloud" />
      <h1>Ты не&nbsp;один.<br />Помощь рядом.</h1>
      <p class="sub">Если тяжело прямо сейчас, позвони. Там выслушают и&nbsp;помогут, ничего объяснять заранее не&nbsp;нужно.</p>
    </header>

    <ul class="calls">
      {lines.map((l) => (
        <li>
          <a class:list={['call', { urgent: l.urgent }]} href={`tel:${l.tel}`}>
            <span class="text">
              <span class="title">{l.title}</span>
              <span class="num">{l.phone}</span>
              <span class="note">{l.note}</span>
            </span>
            <span class="btn" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z" fill="currentColor"/></svg>
            </span>
          </a>
        </li>
      ))}
    </ul>

    <section class="wait">
      <h2>Пока набираешь номер</h2>
      <div class="breath">
        <div class="ring" aria-hidden="true"><MiniCloud size={52} sleepy /></div>
        <p><b>Подыши вместе с облачком.</b> Вдох на&nbsp;четыре счёта, когда оно растёт. Медленный выдох на&nbsp;шесть, когда сжимается.</p>
      </div>
      <p class="tip"><b>Напиши тому, кому доверяешь.</b> Подойдёт простое «мне сейчас тяжело, побудь со&nbsp;мной».</p>
    </section>

    <p class="checked">Номера проверены по&nbsp;<a href={lines[1].source}>официальному сайту МЧС</a> 14.10.2026. Inlo не&nbsp;экстренная служба.</p>
  </div>
</Base>

<style>
  .page { max-width:620px; padding-top:clamp(32px, 7vw, 64px); padding-bottom:24px; display:flex; flex-direction:column; gap:clamp(32px, 6vw, 44px); }

  .intro { display:flex; flex-direction:column; gap:14px; }
  .intro :global(.cloud) { --cloud:#eef2f6; }
  h1 { font-size:clamp(36px, 8vw, 52px); font-weight:600; letter-spacing:-.035em; line-height:1.05; }
  .sub { font-size:clamp(18px, 2.4vw, 21px); line-height:1.45; color:var(--muted); max-width:34ch; }

  .calls { list-style:none; padding:0; display:grid; gap:12px; }
  .call { display:flex; align-items:center; gap:16px; padding:20px 20px 20px 24px; border-radius:22px; text-decoration:none; color:var(--ink);
    background:var(--surface); box-shadow:0 0 0 1px var(--line), 0 10px 30px -18px rgba(29,29,31,.25);
    transition:transform .2s ease, box-shadow .2s ease; }
  .call:hover { transform:translateY(-1px); box-shadow:0 0 0 1px var(--line), 0 16px 36px -18px rgba(29,29,31,.3); }
  .call:active { transform:scale(.99); }
  .text { flex:1; display:flex; flex-direction:column; gap:2px; }
  .title { font-size:15px; font-weight:600; color:var(--muted); }
  .num { font-size:clamp(30px, 7vw, 38px); font-weight:600; letter-spacing:-.025em; line-height:1.15; white-space:nowrap; }
  .note { font-size:16px; color:var(--muted); line-height:1.4; margin-top:4px; }
  .btn { flex:none; display:grid; place-items:center; width:52px; height:52px; border-radius:50%; background:#34c759; color:#fff; }
  .btn svg { width:24px; height:24px; }
  .urgent .title { color:var(--help-ink); }

  .wait { display:grid; gap:18px; padding-top:28px; border-top:1px solid var(--line); }
  h2 { font-size:22px; font-weight:600; letter-spacing:-.02em; }
  .breath { display:flex; align-items:center; gap:18px; }
  .ring { flex:none; display:grid; place-items:center; width:88px; height:88px; border-radius:50%; background:#e7f0f2; }
  .ring :global(svg) { --cloud:#fff; animation:breathe 10s cubic-bezier(.45,0,.55,1) infinite; }
  @keyframes breathe { 0%,100% { transform:scale(.8) } 40% { transform:scale(1.15) } }
  .breath p, .tip { font-size:17px; line-height:1.5; color:var(--muted); }
  .breath b, .tip b { color:var(--ink); font-weight:600; }

  .checked { font-size:13px; color:var(--muted); }
  .checked a { color:inherit; }

  @media (max-width:420px) { .call { padding:18px 16px 18px 18px; } .btn { width:46px; height:46px; } }
  @media (prefers-reduced-motion: reduce) { .ring :global(svg) { animation:none; } .call { transition:none; } }
</style>
