---
import Base from '../layouts/Base.astro';
import MiniCloud from '../components/MiniCloud.astro';
import ChatApp from '../chat/ChatApp';
import { BRAND } from '../lib/brand';
import '../chat/chat.css';

// Страница статичная: чат целиком в браузере, это SPA на Preact (src/chat/ChatApp.tsx).
// client:only, потому что состояние экрана (ворота или переписка) знает только браузер: localStorage и режим PWA.
// Отрисуй его сервер, человек, который уже соглашался, сначала увидел бы мелькнувшие ворота.
---
<Base app title={BRAND} description="Напиши, что тревожит: Inlo выслушает, поможет разобрать мысль и подышит вместе с тобой. ИИ-поддержка, не заменяет психолога, 18+."
  crumb="Поговорить" ogImage="/og/chat.jpg" ogAlt="Облачко Inlo и надпись: поговорить с Inlo, ИИ-поддержка">
  <script is:inline>
    // До загрузки острова, чтобы не было скачка вёрстки: открыто с домашнего экрана, значит режим приложения с нижней навигацией
    if (matchMedia('(display-mode: standalone)').matches || navigator.standalone === true) {
      document.documentElement.classList.add('standalone');
    }
  </script>

  <ChatApp client:only="preact">
    {/* Пока грузится JS: та же шапка, экран не пустой. Без JS объясняем и даём номера помощи */}
    <div class="chat" slot="fallback">
      <header class="bar">
        <a class="back" href="/" aria-label="На главную">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <div class="who">
          <span class="ava"><MiniCloud size={30} /></span>
          <span class="name"><b>{BRAND}</b><small class="status">AI, не психолог</small></span>
        </div>
        <a class="sos" href="/help">Помощь</a>
      </header>
      <noscript><p class="no-js">Чату нужен JavaScript. Если тяжело прямо сейчас, все номера помощи на&nbsp;странице <a href="/help">«Нужна помощь»</a>.</p></noscript>
    </div>
  </ChatApp>
</Base>
