---
// Облачко Mira с «мечтательной аурой». Глаза и цвета меняются по фазе суток (класс на <html>).
---
<div class="stage">
  <div class="aura a1"></div>
  <div class="aura a2"></div>
  <div class="aura a3"></div>
  <div class="fly" style="left:17%; top:77%"></div>
  <div class="fly" style="left:80%; top:80%; animation-delay:1.6s"></div>
  <div class="fly" style="left:31%; top:87%; animation-delay:3.4s"></div>
  <div class="fly" style="left:69%; top:90%; animation-delay:5s"></div>
  <div class="fly" style="left:50%; top:93%; animation-delay:6.5s"></div>
  <svg class="cloud" viewBox="0 0 300 240" role="img" aria-label="Облачко Mira">
    <defs>
      <linearGradient id="cloudFill" x1="0" y1="30" x2="0" y2="214" gradientUnits="userSpaceOnUse">
        <stop offset="0" class="stop1"/>
        <stop offset="1" class="stop2"/>
      </linearGradient>
    </defs>
    <g class="body">
      <g fill="url(#cloudFill)">
        <rect x="40" y="118" width="220" height="96" rx="48"/>
        <circle cx="100" cy="128" r="52"/>
        <circle cx="160" cy="96" r="66"/>
        <circle cx="220" cy="130" r="46"/>
      </g>
      <ellipse cx="128" cy="62" rx="24" ry="10" fill="#fff" opacity=".9" transform="rotate(-18 128 62)"/>
      <ellipse class="cheek" cx="116" cy="164" rx="13" ry="7"/>
      <ellipse class="cheek" cx="206" cy="164" rx="13" ry="7"/>
      <path class="line closed" d="M128 140q10 9 20 0"/>
      <path class="line closed" d="M174 140q10 9 20 0"/>
      <g class="open">
        <ellipse cx="138" cy="140" rx="10" ry="13" fill="#2b2f45"/>
        <ellipse cx="184" cy="140" rx="10" ry="13" fill="#2b2f45"/>
        <circle cx="142" cy="134" r="3.6" fill="#fff"/>
        <circle cx="188" cy="134" r="3.6" fill="#fff"/>
      </g>
      <path class="line smile" d="M154 160q7 6 14 0"/>
    </g>
  </svg>
</div>

<style is:global>
  .stage { position:relative; width:min(360px,90vw); aspect-ratio:6/5; }
  .aura { position:absolute; border-radius:50%; filter:blur(48px); opacity:var(--aura); transition:background-color 2s ease, opacity 2s ease; pointer-events:none; }
  .a1 { width:78%; height:93%; left:-8%; top:5%;  background:var(--a1); animation:drift1 16s ease-in-out infinite alternate; }
  .a2 { width:83%; height:100%; left:39%; top:-5%; background:var(--a2); animation:drift2 19s ease-in-out infinite alternate; }
  .a3 { width:56%; height:67%; left:31%; top:50%; background:var(--a3); opacity:calc(var(--aura) * .75); animation:drift1 13s ease-in-out infinite alternate-reverse; }

  .cloud { position:absolute; left:8%; top:4%; width:84%; overflow:visible; }
  .stop1 { stop-color:var(--c1); transition:stop-color 2s ease; }
  .stop2 { stop-color:var(--c2); transition:stop-color 2s ease; }
  .body { transform-box:fill-box; transform-origin:50% 90%; animation:float 9s cubic-bezier(.45,0,.55,1) infinite;
          filter:drop-shadow(0 0 28px var(--glow)); }
  .cheek { fill:#ffb3c8; opacity:.55; }
  .line { fill:none; stroke:#2b2f45; stroke-width:4; stroke-linecap:round; }
  .smile { stroke-width:3.5; }
  .closed { opacity:0; }
  .open { transform-box:fill-box; transform-origin:50% 50%; }

  /* Глаза по фазам */
  .day .open      { animation:blink 5.5s infinite; }
  .morning .open  { animation:drowsy 9s ease-in-out infinite; }
  .morning .closed{ animation:drowsy-lid 9s ease-in-out infinite; }
  .evening .open  { animation:slow-blink 8s ease-in-out infinite; }
  .night .closed  { opacity:1; animation:sleep 14s ease-in-out infinite; }
  .night .open    { opacity:0; animation:wake 14s ease-in-out infinite; }

  .fly { position:absolute; width:6px; height:6px; border-radius:50%; background:var(--fly);
         box-shadow:0 0 10px 3px var(--glow); opacity:0; animation:fly 8s ease-in-out infinite; }
  .day .fly, .morning .fly { box-shadow:none; }

  @keyframes drift1 { 0%{transform:translate(0,0) scale(1)} 100%{transform:translate(11%,-8%) scale(1.15)} }
  @keyframes drift2 { 0%{transform:translate(0,0) scale(1.1)} 100%{transform:translate(-14%,10%) scale(.9)} }
  @keyframes float { 0%,100%{transform:translateY(0) rotate(-1deg) scale(1,1)} 50%{transform:translateY(-16px) rotate(1deg) scale(1.03,1.04)} }
  @keyframes blink { 0%,90%,94%,100%{transform:scaleY(1)} 92%{transform:scaleY(.08)} }
  @keyframes drowsy { 0%,8%{opacity:0;transform:scaleY(.1)} 16%,52%{opacity:1;transform:scaleY(1)} 58%,70%{opacity:1;transform:scaleY(.45)} 76%{opacity:0;transform:scaleY(.1)} 84%{opacity:1;transform:scaleY(1)} 100%{opacity:0;transform:scaleY(.1)} }
  @keyframes drowsy-lid { 0%,8%{opacity:1} 14%,72%{opacity:0} 76%{opacity:1} 82%,96%{opacity:0} 100%{opacity:1} }
  @keyframes slow-blink { 0%,70%,86%,100%{transform:scaleY(1)} 76%,80%{transform:scaleY(.08)} }
  @keyframes sleep { 0%,64%{opacity:1} 67%,90%{opacity:0} 93%,100%{opacity:1} }
  @keyframes wake { 0%,64%{opacity:0;transform:scaleY(.1)} 68%{opacity:1;transform:scaleY(1)} 76%{transform:scaleY(1)} 77.5%{transform:scaleY(.1)} 79%,87%{opacity:1;transform:scaleY(1)} 91%,100%{opacity:0;transform:scaleY(.1)} }
  @keyframes fly { 0%{opacity:0;transform:translate(0,0) scale(.5)} 20%{opacity:1} 50%{transform:translate(12px,-60px) scale(1)} 80%{opacity:.8} 100%{opacity:0;transform:translate(-8px,-130px) scale(.6)} }

  @media (prefers-reduced-motion: reduce) {
    .aura, .body, .fly, .open, .closed { animation:none !important; }
    .fly { display:none; }
  }
</style>
