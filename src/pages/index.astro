---
import { BRAND } from '../lib/brand';
import Base from '../layouts/Base.astro';
import Cloud from '../components/Cloud.astro';
import Phone from '../components/Phone.astro';
import Sky from '../components/Sky.astro';
import VoicePreview from '../components/VoicePreview.astro';

// Заголовок проявляется по словам, как на apple.com. Неразрывные пары держим вместе.
const headline = ['Когда', 'в\u00a0голове', 'шумно,', `${BRAND}`, 'рядом.'];
// Частые вопросы. Ответы сверены с политикой конфиденциальности и планом тарифов, не обещаем лишнего.
const faq = [
  [`${BRAND} это психолог?`, `Нет. ${BRAND} это AI-ассистент: выслушает, поможет разобрать тревожную мысль по шагам когнитивно-поведенческой терапии и подышит вместе с тобой. Диагнозов не ставит и лечение не назначает. Если нужен специалист, подскажет, к кому обратиться.`],
  ['Кто увидит, что я пишу?', `Имя, телефон и почту ${BRAND} не спрашивает. Переписка хранится на сервере в России не дольше 30 дней, удалить её можно в чате одной кнопкой. Чтобы получить ответ, текст сообщения передаётся российскому провайдеру языковой модели.`, '/privacy', 'Политика конфиденциальности'],
  ['Сколько это стоит?', `Основное бесплатно: разговор текстом, дыхание и контакты помощи. Позже появится ${BRAND} Plus: голос без ограничений и сохранённая история разговоров. Контакты помощи в трудную минуту всегда бесплатны.`],
  ['Что делать, если совсем плохо?', `Не жди ответа от AI. Звони 112 или на линию психологической помощи МЧС: +7 495 989-50-50, круглосуточно и бесплатно. Если в разговоре прозвучит что-то тревожное, ${BRAND} сама покажет эти номера.`, '/help', 'Все номера помощи'],
  ['Когда можно будет поговорить?', 'Запуск в ноябре 2026 года, в Telegram и прямо на этом сайте. Подышать вместе с облачком можно уже сейчас, чуть выше на этой странице.'],
];
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
};
// Пока сервер бота не подключён, кодам негде активироваться: честно пишем «скоро»
const chatLive = !!import.meta.env.PUBLIC_MIRA_API;
const limits = [
  ['Это AI', `${BRAND} работает на искусственном интеллекте и всегда честно скажет об этом.`],
  ['Без диагнозов', 'Поддерживает и помогает разобраться, а диагнозы и лекарства оставляет врачам.'],
  ['Подскажет, кто поможет', `Если станет совсем тяжело, ${BRAND} сразу даст контакты людей, которые рядом круглосуточно.`],
  ['Для взрослых', 'Сервис рассчитан на тех, кому уже есть 18.'],
];
---
<Base title={`${BRAND}: AI-поддержка, когда тревожно и не спится`} description={`${BRAND} выслушает, поможет спокойно разобрать тревожную мысль по шагам КПТ и подышит вместе с тобой. Текстом или голосом, в Telegram и на сайте. Запуск в ноябре 2026.`}>
  <section class="hero tile">
    <Sky />
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="status">{chatLive ? <>AI-поддержка · 18+</> : <><i aria-hidden="true"></i>AI-поддержка · запуск в&nbsp;ноябре</>}</p>
        <h1 aria-label={headline.join(' ')}>{headline.map((w, i) => <>{i > 0 && ' '}<span class="w" aria-hidden="true" style={`--w:${i}`}>{w}</span></>)}</h1>
        <p class="sub">Выслушает, поможет разобрать тревожную мысль и&nbsp;подышит вместе с&nbsp;тобой. Текстом или голосом, в&nbsp;любое время.</p>
        {/* До запуска чата главная кнопка ведёт туда, где польза есть уже сейчас: подышать (ux-logic §3.1) */}
        <p class="meta">{chatLive
          ? <a class="cta" href="/chat">Поговорить с&nbsp;{BRAND}</a>
          : <a class="cta" href="/breathe">Подышать минуту</a>}<a class="link" href="#talk">Как это устроено&nbsp;›</a></p>
      </div>
      <div class="hero-phone theme"><Phone /></div>
    </div>
  </section>

  <section id="talk" class="block reveal">
    <div class="wrap narrow">
      <p class="eyebrow">Поговорить</p>
      <h2>Можно просто выговориться.</h2>
      <p class="lead">{BRAND} не перебивает и не оценивает. А если захочешь, поможет спокойно разложить тревожную мысль по шагам, как это делают в когнитивно-поведенческой терапии.</p>
      <ol class="cbt" style="--n:4">
        <li><span>Что случилось</span><em>«Завтра разговор с начальником»</em></li>
        <li><span>Что ты подумал</span><em>«Меня точно уволят»</em></li>
        <li><span>Что есть на самом деле</span><em>«Он хотел обсудить проект»</em></li>
        <li><span>Как на это можно посмотреть</span><em>«Это разговор, а не приговор»</em></li>
      </ol>
    </div>
  </section>

  <section class="block breathe tile reveal">
    <Sky />
    <div class="wrap narrow center">
      <p class="eyebrow">Подышать</p>
      <h2>Минута, которая меняет тон вечера.</h2>
      <div class="breath-stage" aria-hidden="true" title="Погладь облачко">
        <Cloud />
        <p class="cue"><span class="in">Вдох</span><span class="out">Выдох</span></p>
      </div>
      <p class="br-actions"><a class="cta" href="/breathe">Подышать минуту</a><button class="pause" type="button" aria-pressed="false">Пауза</button></p>
      <p class="lead glass">Медленное дыхание с&nbsp;длинным выдохом помогает телу успокоиться. Облачко дышит в&nbsp;темпе шесть вдохов в&nbsp;минуту, тебе остаётся только повторять.</p>
    </div>
  </section>

  <section class="block reveal">
    <div class="wrap narrow">
      <p class="eyebrow">Услышать</p>
      <h2>Голос, а&nbsp;не&nbsp;робот.</h2>
      <p class="lead">Ответы {BRAND} можно слушать. Голоса записываем с&nbsp;живыми людьми специально для неё: мужской и&nbsp;женский, на&nbsp;выбор.</p>
      <VoicePreview />
    </div>
  </section>

  <section class="block reveal">
    <div class="wrap narrow">
      <p class="eyebrow">Важно знать</p>
      <h2>Тёплая поддержка с&nbsp;честными границами.</h2>
      <p class="lead">{BRAND} рядом, когда нужно выговориться или успокоиться. А&nbsp;в&nbsp;том, что требует специалиста, она подскажет, к&nbsp;кому обратиться.</p>
      <dl class="limits">
        {limits.map(([t, d]) => (<div class="glass"><dt>{t}</dt><dd>{d}</dd></div>))}
      </dl>
    </div>
  </section>

  <section id="plans" class="block reveal">
    <div class="wrap">
      <div class="narrow-head">
        <p class="eyebrow">Тарифы</p>
        <h2>Главное бесплатно.</h2>
        <p class="lead">Поговорить, подышать и&nbsp;найти помощь можно без оплаты. {BRAND}&nbsp;Plus для тех, кто хочет слушать {BRAND} и&nbsp;возвращаться к&nbsp;своим разговорам.</p>
      </div>
      <div class="plans">
        <article class="plan glass">
          <h3>Бесплатно</h3>
          <p class="price">0&nbsp;₽</p>
          <ul>
            <li>Разговор с&nbsp;{BRAND} текстом</li>
            <li>Несколько голосовых ответов на&nbsp;пробу</li>
            <li>Дыхательные упражнения</li>
            <li>Номера помощи 24/7, всегда без лимитов</li>
          </ul>
          {chatLive
            ? <a class="plan-btn" href="/chat">Поговорить с&nbsp;{BRAND}</a>
            : <a class="plan-btn" href="/breathe">Подышать сейчас</a>}
        </article>
        <article class="plan plus">
          <h3>{BRAND}&nbsp;Plus</h3>
          <p class="price">Цена появится к&nbsp;запуску</p>
          <ul>
            <li>{BRAND} отвечает голосом, без ограничений</li>
            <li>История разговоров сохраняется</li>
            <li>Всё, что есть в&nbsp;бесплатной версии</li>
          </ul>
          {chatLive
            ? <><a class="plan-btn hi" href="/chat#plus">У&nbsp;меня есть код</a><p class="plan-note">Тестировщикам код выдаёт команда {BRAND}.</p></>
            : <p class="plan-note">Коды для тестировщиков заработают вместе с&nbsp;чатом, к&nbsp;запуску.</p>}
        </article>
      </div>
    </div>
  </section>

  <section id="faq" class="block reveal">
    <div class="wrap narrow">
      <p class="eyebrow">Вопросы</p>
      <h2>Коротко о&nbsp;главном.</h2>
      <div class="faq glass">
        {faq.map(([q, a, href, label]) => (
          <details>
            <summary><span>{q}</span><i aria-hidden="true"></i></summary>
            <p>{a}{href && <> <a class="link" href={href}>{label}&nbsp;›</a></>}</p>
          </details>
        ))}
      </div>
    </div>
    <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  </section>

  <section class="block reveal">
    <div class="wrap narrow">
      <p class="crisis">Если тяжело прямо сейчас, не&nbsp;жди запуска. <a class="link" href="/help">Куда позвонить&nbsp;›</a></p>
    </div>
  </section>
</Base>

<script>
  // Облачко просыпается: от наведения мышью или касания открывает глаза и подпрыгивает, взгляд следует за курсором
  const stage = document.querySelector<HTMLElement>('.breath-stage .stage');
  if (stage) {
    let sleep = 0;
    const wake = (hop: boolean) => {
      stage.classList.add('awake');
      if (hop) { stage.classList.remove('hop'); void stage.offsetWidth; stage.classList.add('hop'); }
      clearTimeout(sleep);
      sleep = window.setTimeout(() => { stage.classList.remove('awake'); stage.style.removeProperty('--lx'); stage.style.removeProperty('--ly'); }, 2600);
    };
    stage.addEventListener('animationend', (e) => { if ((e.target as Element).classList.contains('cloud')) stage.classList.remove('hop'); });
    stage.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') wake(true); });
    stage.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse') return;
      const r = stage.getBoundingClientRect();
      const k = (v: number) => Math.max(-1, Math.min(1, v)) * 7;
      stage.style.setProperty('--lx', `${k((e.clientX - r.left) / r.width * 2 - 1)}px`);
      stage.style.setProperty('--ly', `${k((e.clientY - r.top) / r.height * 2 - 1)}px`);
      wake(false);
    });
    stage.addEventListener('click', () => wake(true));
  }

  const b = document.querySelector('.breathe');
  const btn = b?.querySelector('.pause');
  btn?.addEventListener('click', () => {
    const p = b!.classList.toggle('paused');
    btn.setAttribute('aria-pressed', String(p));
    btn.textContent = p ? 'Продолжить' : 'Пауза';
  });
</script>

<style>
  .hero { margin-top:8px; padding: clamp(48px, 8vw, 104px) 0 clamp(48px, 7vw, 88px); overflow-x:clip; }
  .hero > .wrap { position:relative; z-index:1; }
  .hero-grid { display:grid; gap:48px; align-items:center; grid-template-columns: 1.15fr 1fr; }
  .hero h1 { font-size: clamp(40px, 6.4vw, 72px); letter-spacing:-.035em; line-height:1.04; text-wrap:balance; }
  .sub { margin-top:20px; font-size: clamp(19px, 2.2vw, 23px); line-height:1.4; color:var(--muted); max-width:30ch; }
  .meta { margin-top:28px; display:flex; flex-wrap:wrap; gap:8px 24px; font-size:17px; color:var(--muted); }
  .meta { align-items:center; }
  .cta { font-weight:600; color:var(--accent-ink); background:var(--accent); padding:12px 22px; border-radius:999px; text-decoration:none; box-shadow:0 10px 24px -12px color-mix(in srgb, var(--accent) 80%, transparent); transition:transform .2s cubic-bezier(.3,.7,.2,1); }
  .cta { transition:transform .45s cubic-bezier(.3,1.5,.4,1), box-shadow .45s ease; }
  .cta:hover { transform:scale(1.04); box-shadow:0 16px 30px -12px color-mix(in srgb, var(--accent) 85%, transparent); }
  .cta:active { transform:scale(.96); transition-duration:.12s; }
  .hero-phone { display:flex; justify-content:center; position:relative; }
  .hero-phone::before { content:""; position:absolute; inset:10% -10%; background:radial-gradient(closest-side, var(--glow), transparent); z-index:-1; }
  /* Вход: слова заголовка всплывают из размытия одно за другим, затем текст, кнопка и телефон */
  .hero h1 .w { display:inline-block; opacity:0; filter:blur(10px); transform:translateY(.32em);
    animation: word 1.1s cubic-bezier(.2,.75,.2,1) forwards; animation-delay:calc(.08s + var(--w) * .085s); }
  @keyframes word { to { opacity:1; filter:none; transform:none } }
  .hero-copy > :not(h1) { opacity:0; animation: up 1s cubic-bezier(.2,.7,.2,1) forwards; }
  .hero-copy > .status { animation-delay:0s } .hero-copy > .sub { animation-delay:.5s } .hero-copy > .meta { animation-delay:.62s }
  /* Плашка статуса: сразу видно, что это и на каком этапе */
  .status { display:inline-flex; align-items:center; gap:8px; margin-bottom:18px; padding:6px 13px; border-radius:999px; font-size:14px; font-weight:600;
    color:var(--accent); background:color-mix(in srgb, var(--accent) 10%, transparent); }
  .status i { width:7px; height:7px; border-radius:50%; background:currentColor; animation:pulse 2.4s ease-in-out infinite; }
  @keyframes pulse { 50% { opacity:.35; transform:scale(.8) } }
  @keyframes up { from { opacity:0; transform:translateY(16px) } to { opacity:1; transform:none } }
  /* Телефон выезжает снизу с лёгким наклоном и «встаёт» ровно */
  .hero-phone { perspective:1400px; }
  .hero-phone :global(.phone) { view-transition-name: mira-chat; animation: phone-in 1.5s cubic-bezier(.16,.84,.24,1) .25s both; transform-origin:50% 80%; }
  @keyframes phone-in { from { opacity:0; transform:translateY(90px) rotateX(24deg) scale(.9) } }
  .hero-phone::before { animation: glow-in 2s ease .4s both; }
  @keyframes glow-in { from { opacity:0; transform:scale(.7) } }

  .block { padding: clamp(64px, 11vw, 128px) 0; overflow-x:clip; }
  .narrow { max-width:760px; }
  .center { text-align:center; }
  .center .lead { margin-inline:auto; }
  .eyebrow { font-size:17px; font-weight:600; color:var(--accent); margin-bottom:12px; }
  h2 { font-size: clamp(34px, 5.2vw, 56px); text-wrap:balance; }
  .lead { margin-top:20px; font-size: clamp(19px, 2vw, 21px); line-height:1.5; color:var(--muted); max-width:36ch; }

  .cbt { list-style:none; padding:0; margin-top:44px; counter-reset:s; }
  .cbt { position:relative; }
  .cbt li { position:relative; display:grid; grid-template-columns: 2.2em 1fr; grid-template-rows:auto auto; padding:16px 0; border-top:1px solid var(--line); counter-increment:s; }
  .cbt li::before { content:counter(s); grid-row: span 2; color:var(--muted); font-variant-numeric:tabular-nums; }
  .cbt span { font-weight:600; }
  .cbt em { font-style:normal; color:var(--muted); }

  .breathe { padding-block: clamp(96px, 15vw, 176px); }
  .breathe .lead { margin:28px auto 0; padding:16px 20px; border-radius:22px; color:var(--ink); }
  .breathe > .wrap { position:relative; z-index:1; }
  .breath-stage { position:relative; margin: 32px auto 0; width:min(340px, 82vw); }
  .breath-stage :global(.stage) { width:100%; }
  .breath-stage :global(.body) { animation: breathe-big 10s cubic-bezier(.45,0,.55,1) infinite !important; }
  .cue { position:relative; height:1.5em; margin-top:4px; font-size:19px; font-weight:600; color:var(--muted); }
  .cue span { position:absolute; inset:0; animation: cue 10s linear infinite; }
  .cue .out { animation-name: cue-out; }
  @keyframes breathe-big { 0%,100% { transform: scale(.86) translateY(6px) } 40% { transform: scale(1.06) translateY(-6px) } }
  /* Слова не пересекаются: одно гаснет, потом проявляется другое */
  @keyframes cue { 0%,35% { opacity:1 } 38.5%,97% { opacity:0 } 100% { opacity:1 } }
  @keyframes cue-out { 0%,39.5% { opacity:0 } 43%,93% { opacity:1 } 96.5%,100% { opacity:0 } }

  .br-actions { margin-top:14px; display:flex; flex-wrap:wrap; justify-content:center; align-items:center; gap:8px 14px; }
  .pause {  font:inherit; font-size:15px; color:var(--accent); background:none; border:0; padding:10px 14px; cursor:pointer; }
  .breathe.paused :global(.body), .breathe.paused .cue span, .breathe.paused :global(.sky *) { animation-play-state:paused !important; }

  /* Границы: бенто-сетка из стеклянных плиток */
  .limits { margin-top:40px; display:grid; grid-template-columns:1fr 1fr; gap:14px; }
  .limits > div { padding:24px 24px 26px; border-radius:26px; transition:transform .5s cubic-bezier(.3,1.4,.4,1); }
  .limits dt { font-weight:600; font-size:21px; letter-spacing:-.02em; }
  .limits dd { margin-top:6px; color:var(--muted); }
  @media (hover: hover) { .limits > div:hover { transform:translateY(-3px) scale(1.01); } }

  /* Привязка к прокрутке там, где браузер умеет (Safari 26, Chrome). Остальные видят обычную страницу. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      /* Уходя вверх, hero медленнее страницы: текст гаснет, телефон отъезжает и чуть уменьшается */
      .hero-copy { animation: hero-out linear both; animation-timeline: view(); animation-range: exit 0% exit 90%; }
      @keyframes hero-out { to { opacity:0; transform:translateY(-40px); filter:blur(6px) } }
      .hero-phone { animation: phone-out linear both; animation-timeline: view(); animation-range: exit 10% exit 100%; }
      @keyframes phone-out { to { transform:translateY(60px) scale(.92); opacity:.4 } }
      /* Шаги КПТ: слева прорисовывается линия по мере прокрутки */
      .cbt::before { content:""; position:absolute; left:-14px; top:16px; bottom:16px; width:2px; border-radius:2px; background:var(--accent);
        transform-origin:top; animation: draw linear both; animation-timeline: view(); animation-range: entry 60% cover 55%; opacity:.5; }
      @keyframes draw { from { transform:scaleY(0) } }
      /* Небо и облачко в «Подышать» двигаются с разной скоростью: глубина без картинок */
      .breathe :global(.sky) { animation: sky-par linear both; animation-timeline: view(); }
      @keyframes sky-par { from { transform:translateY(-6%) scale(1.14) } to { transform:translateY(6%) scale(1.14) } }
      .breath-stage { animation: stage-par linear both; animation-timeline: view(); animation-range: entry 0% cover 50%; }
      @keyframes stage-par { from { transform:translateY(60px) scale(.9); opacity:.2 } }
    }
  }

  /* Тарифы: две карточки, у Plus мягко переливается рамка */
  .narrow-head { max-width:860px; margin-inline:auto; }
  .plans { margin:48px auto 0; max-width:860px; display:grid; grid-template-columns:1fr 1fr; gap:20px; align-items:stretch; }
  .plan { position:relative; display:flex; flex-direction:column; gap:10px; padding:30px 28px 26px; border-radius:28px; background:var(--surface);
    box-shadow:0 0 0 1px var(--line); transition:transform .5s cubic-bezier(.2,.8,.2,1); }
  .plan.glass { background:var(--glass-bg); box-shadow:inset 0 0 0 .5px var(--glass-rim), inset 0 1px 0 var(--glass-hi), 0 0 0 1px var(--glass-edge), 0 24px 50px -32px rgba(16,24,48,.35); }
  @media (hover: hover) { .plan:hover { transform:translateY(-4px); } }
  .plan h3 { font-size:24px; letter-spacing:-.02em; display:flex; align-items:center; gap:8px; }
  .plan .price { font-size:17px; font-weight:600; color:var(--muted); }
  .plan ul { list-style:none; padding:0; margin:8px 0 18px; display:grid; gap:10px; flex:1; align-content:start; }
  .plan li { position:relative; padding-left:28px; line-height:1.4; }
  .plan li::before { content:""; position:absolute; left:2px; top:.3em; width:16px; height:16px; border-radius:50%; background:color-mix(in srgb, var(--accent) 18%, transparent); }
  .plan li::after { content:""; position:absolute; left:7px; top:calc(.3em + 4px); width:6px; height:4px; border:2px solid var(--accent); border-top:0; border-right:0; transform:rotate(-45deg); }
  .plan-btn { align-self:flex-start; font-weight:600; font-size:16px; text-decoration:none; padding:11px 22px; border-radius:999px; color:var(--accent-ink); background:var(--accent);
    transition:transform .45s cubic-bezier(.3,1.5,.4,1); }
  .plan-btn:hover { transform:scale(1.04); } .plan-btn:active { transform:scale(.96); transition-duration:.12s; }
